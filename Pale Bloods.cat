              </costs>
              <profiles>
                <profile id="7edf-6f93-0fb5-2eeb" name="Bloody Machete" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="66" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Brutal: Critical strikes deal + [MORTAL] Potency.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="b83c-5fe9-1e99-9ab7" name="Throwing Knives" type="upgrade" hidden="false" page="66" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="12" />
              </costs>
              <profiles>
                <profile id="b46b-9d21-996b-709d" name="Throwing Knives" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="66" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Ranged: 12”.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Small Weapon: This character may make a free Ranged Attack before making a Sprint or Charge.
Stealth Attack: This weapon adds +2 Velocity when the target of the attack considers this character obscured by darkness.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="6d3e-3f1e-e185-9927" name="Old Shotgun" type="upgrade" hidden="false" page="66" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="14" />
              </costs>
              <profiles>
                <profile id="4e5b-483f-0d84-f64f" name="Old Shotgun" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="66" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Firearm. Ranged.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Point-Blank: + [MORTAL] [MORTAL] Potency when firing at a target within 4”.
Poorly Maintained: If you roll a 1 while firing, this gun jams and cannot be fired again until you spend a simple interact action to clear the jam.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="2069-94be-a66e-f026" name="Despoiler Scythe" type="upgrade" hidden="false" page="66" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="18" />
              </costs>
              <profiles>
                <profile id="175d-64ce-38c5-22d8" name="Despoiler Scythe" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="66" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+1</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Dominance: When you successfully strike a cowering enemy, you remove all STRESS.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="79c5-ad40-fd55-1d74" name="Skull Cane" type="upgrade" hidden="false" page="67" publicationId="a21c-395e-03ec-6dcd">
