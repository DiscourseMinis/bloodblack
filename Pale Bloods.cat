              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="12" />
              </costs>
              <constraints>
                <constraint id="ad69-e81b-1749-a69e" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="a8b2-1ed9-9b77-77e6" name="Screaming Necklace" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
