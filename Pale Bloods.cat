          <characteristics>
            <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Unique. Restriction: Vampire only.</characteristic>
            <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per game, when this Character would be killed, you may destroy this item instead. If you do, the Character survives with 1 VITALITY.</characteristic>
