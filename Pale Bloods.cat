                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Defensive: +1 REFLEX against MELEE attacks.
Skilled: Add your FINESSE stat as Velocity to melee attacks with this weapon.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="3acb-2fc8-fbb6-d2fb" name="Ruinous Kilĳ" type="upgrade" hidden="false" page="74" publicationId="a21c-395e-03ec-6dcd">
              <costs>
