              </constraints>
              <profiles>
                <profile id="a361-caad-7970-2a8f" name="Nightmare Trinket" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="68" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Enemy Characters within 4″ of this Character suffer −1 POWER. A character can suffer this penalty only once, regardless of how many Nightmare Trinkets are within range.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
