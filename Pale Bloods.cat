                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Bouncing Blade: Adds +2 Velocity when more than one character is the target of this attack.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="c7c8-a45c-ea12-7f5a" name="Torment Urumi" type="upgrade" hidden="false" page="74" publicationId="a21c-395e-03ec-6dcd">
