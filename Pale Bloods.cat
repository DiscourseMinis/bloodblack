              <profiles>
                <profile id="db8c-f156-9b8e-c1a0" name="Nightmare Predator" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="74" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Vampire only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This Character gains +2 Velocity when attacking a Character without another Character (excluding this one) within 8”.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="1621-c8d3-ec65-b297" name="Infected Brood" type="upgrade" hidden="false" page="74" publicationId="a21c-395e-03ec-6dcd">
