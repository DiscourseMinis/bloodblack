              </constraints>
              <profiles>
                <profile id="cf99-0e1e-c468-25fa" name="Frenzied Feeder" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="68" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Vampire only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once during this character's activation, after it kills an enemy in MELEE, it may immediately make a free MELEE ATTACK against another Enemy Character it is ENGAGED with.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
