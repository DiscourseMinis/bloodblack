              </costs>
              <constraints>
                <constraint id="3d99-9b6e-a033-7d8f" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="c4cd-5d06-f31e-10b9" name="Mastery of Shadows" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Vampire only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This character is Obscured by Darkness when more than 4" from an attacker, rather than 8". While Illuminated, this character cannot remove STRESS, except by performing a FLEE action.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="4b51-7135-e834-f723" name="Shadow Play" type="upgrade" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
              </costs>
              <constraints>
                <constraint id="79e4-d322-71a5-4c60" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="d8b0-b744-09a6-6196" name="Shadow Play" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Vampire only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, after an enemy Activation Token is drawn from the Chaos Bag, you may nominate one friendly Character to gain +1 die on its next REFLEX test this turn. A Character can have only one unused bonus from Shadow Play at a time.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="6c17-a403-7348-c72f" name="Corpse Mimicry" type="upgrade" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
              </costs>
              <constraints>
                <constraint id="0bff-3401-a8c2-8281" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="a0a2-454d-afb6-c3b7" name="Corpse Mimicry" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Vampire only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per game, after surviving an attack that causes this character to lose VITALITY, it may feign death. Until it next performs an action, COGs cannot target it, and enemy player characters must win an opposed POWER TEST against it before targeting it with an attack. If the test fails, they must choose another target.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
