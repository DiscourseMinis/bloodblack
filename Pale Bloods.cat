      </categoryLinks>
      <costs>
        <cost name="Influence" typeId="f178-88bc-7258-0c88" value="130" />
      </costs>
      <profiles>
        <profile id="3deb-5630-5422-aeb5" name="Grotesque" typeId="7379-d42a-a99d-2084" typeName="Character (base profile)" publicationId="a21c-395e-03ec-6dcd" page="60" hidden="false">
          <characteristics>
            <characteristic name="Speed" typeId="5c3c-1745-c6f4-e1ab">7</characteristic>
            <characteristic name="Might" typeId="6c6c-02be-13ea-abc0">4</characteristic>
            <characteristic name="Finesse" typeId="ac91-114f-a56f-ac40">3</characteristic>
            <characteristic name="Power" typeId="58ce-692d-f1ed-f0d2">3</characteristic>
            <characteristic name="Reflex" typeId="285f-f125-f518-8cd9">1</characteristic>
            <characteristic name="Resilience" typeId="fc73-5c60-9144-ba15">3</characteristic>
            <characteristic name="Vitality" typeId="aa79-6e65-6e8c-b0da">15</characteristic>
            <characteristic name="Traits" typeId="9100-254c-435d-4a59">Vampire.</characteristic>
            <characteristic name="Innate weapons" typeId="5f99-0e22-522c-59bc">Vicious Claws, Vampire Bite</characteristic>
          </characteristics>
        </profile>
        <profile id="ae47-8008-45e3-d841" name="Endocannibal Ritual" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="60" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Free</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Once per turn, after you kill an enemy character, you may heal 2 VITALITY and 1 STRESS.</characteristic>
          </characteristics>
        </profile>
        <profile id="6c73-31c1-b53f-d678" name="Bloodthirsty" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="60" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">This character gains +1 MIGHT for each missing VITALITY, up to a maximum of +3.</characteristic>
          </characteristics>
        </profile>
        <profile id="bb9e-08df-e5c8-0e9c" name="Tormented" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="60" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">This Character cannot interact with objectives, does not count as a friendly character for the purpose of control of objectives and cannot equip assets other than Blood Boons, or weapons.</characteristic>
          </characteristics>
        </profile>
        <profile id="969b-c14f-49e6-5d0c" name="Sanguine Vigour" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="60" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">During this character’s activation, or when it is targeted by an attack before any dice are rolled, it may spend 1 VITALITY per Blood Boon to activate its effects until the end of the turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="6061-75de-d30f-5800" name="Uncanny Movement" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="60" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">This character may move over or onto terrain and obstacles up to 4″ higher than its starting surface, ignoring vertical distance when measuring movement. When jumping, this character may jump up to its full Speed during a Move, or double its Speed during a Sprint.</characteristic>
          </characteristics>
        </profile>
        <profile id="0da6-2d8d-41d9-b4b3" name="Heliophobia" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="60" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">When this character suffers any amount of [FIRE] damage, they gain +1 STRESS after resolving the damage.</characteristic>
          </characteristics>
        </profile>
        <profile id="8b22-b263-6aaa-1428" name="Vicious Claws" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="60" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
            <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
            <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Innate. Melee</characteristic>
            <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Innate: Can never be disarmed.
Momentum: CHARGE attacks gain + [MORTAL] Potency.</characteristic>
          </characteristics>
        </profile>
        <profile id="7c9c-4b94-77cd-5b61" name="Vampire Bite" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="60" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
            <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
            <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Innate. Melee</characteristic>
            <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Innate: Can never be disarmed.
Life-Steal: Damage dealt by this attack is returned to the attacker as VITALITY, up to the attackers maximum VITALITY.
Blood Sucker: Can target friendly MORTAL Characters. They do not roll Reflex to resist.</characteristic>
          </characteristics>
        </profile>
        <profile id="727c-87fa-2136-12f4" name="Activating Blood Boons" typeId="653c-9eec-114f-7b3e" typeName="Casting" hidden="false" page="65" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Procedure" typeId="a469-c2c4-8dee-eacd">Choose how many purchased ranks of a Blood Boon to activate, then lose 1 Vitality regardless of the number of ranks chosen. This cost ignores Resilience and cannot reduce the Vampire below 1 Vitality. Each Boon can be activated once per turn. Total active ranks across all Boons cannot exceed unmodified Power.</characteristic>
          </characteristics>
        </profile>
      </profiles>
