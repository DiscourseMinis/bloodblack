                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Defensive: +1 REFLEX against MELEE attacks.
Riposte: When this character rolls at least two successes on a REFLEX TEST against a MELEE attack, it deals damage equal to this weapon’s Potency to the attacker. Riposte can apply only once per incoming attack.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="d1be-a51f-70f1-f15c" name="Brazen Chakram" type="upgrade" hidden="false" page="74" publicationId="a21c-395e-03ec-6dcd">
