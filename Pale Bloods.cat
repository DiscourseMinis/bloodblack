              </costs>
              <profiles>
                <profile id="baa3-0905-367c-1960" name="Ruinous Kilĳ" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="74" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+2</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Defensive: +1 REFLEX against MELEE attacks.
Riposte: When this character rolls at least two successes on a REFLEX TEST against a MELEE attack, it deals damage equal to this weapon’s Potency to the attacker. Riposte can apply only once per incoming attack.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="7d00-1343-9449-30a0" name="Brazen Chakram" type="upgrade" hidden="false" page="74" publicationId="a21c-395e-03ec-6dcd">
              <costs>
