              <profiles>
                <profile id="64bd-7b9b-f0ee-f969" name="Preternatural" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="68" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Vampire only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, this character may suffer 1 STRESS to reroll one failed die on a MIGHT, FINESSE, or REFLEX TEST.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="4c10-b283-35e0-7574" name="Transcendent Beauty" type="upgrade" hidden="false" page="68" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="8" />
              </costs>
              <constraints>
                <constraint id="e45c-bcf8-f564-37b6" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="4e75-6fb3-35be-0dff" name="Transcendent Beauty" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="68" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Vampire only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, when this Character is targeted by a MELEE ATTACK, it may gain 1 STRESS to reduce the attacker’s dice pool by 2 (to a minimum of 1 die). If the attacker is a COG, it instead suffers −1 Attack for that attack.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="7c0b-1b2f-6379-db47" name="Bloodlust" type="upgrade" hidden="false" page="68" publicationId="a21c-395e-03ec-6dcd">
