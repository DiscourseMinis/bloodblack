              </constraints>
              <profiles>
                <profile id="6a34-a54a-610d-0858" name="Infected Brood" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="74" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When this character is killed, spawn a Chittering Mass COG in base contact with its last position, or as close as possible if there is insufficient space. This COG is controlled by PROGRAM as normal.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="c330-3619-8c68-9358" name="Mastery of Shadows" type="upgrade" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="18" />
              </costs>
              <constraints>
                <constraint id="7ce0-3635-fe2e-df83" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="5b93-483b-8fb3-426e" name="Mastery of Shadows" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Vampire only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This character is Obscured by Darkness when more than 4" from an attacker, rather than 8". While Illuminated, this character cannot remove STRESS, except by performing a FLEE action.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="b256-d8a5-3c3a-0c9b" name="Shadow Play" type="upgrade" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
              </costs>
              <constraints>
                <constraint id="66eb-8f79-b724-20d8" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="e636-8afb-2670-d11d" name="Shadow Play" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Vampire only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, after an enemy Activation Token is drawn from the Chaos Bag, you may nominate one friendly Character to gain +1 die on its next REFLEX test this turn. A Character can have only one unused bonus from Shadow Play at a time.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="a180-7510-a2e2-4af6" name="Corpse Mimicry" type="upgrade" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
              </costs>
              <constraints>
                <constraint id="eb6f-764c-93d8-c5cd" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="ef2f-fa87-72a2-c676" name="Corpse Mimicry" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Vampire only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per game, after surviving an attack that causes this character to lose VITALITY, it may feign death. Until it next performs an action, COGs cannot target it, and enemy player characters must win an opposed POWER TEST against it before targeting it with an attack. If the test fails, they must choose another target.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="f2a4-d4f9-096d-67f4" name="Screaming Necklace" type="upgrade" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="12" />
              </costs>
              <constraints>
                <constraint id="fa24-3c6a-415e-73b4" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="f345-e463-3e49-cdfd" name="Screaming Necklace" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
