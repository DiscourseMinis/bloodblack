                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+2</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Firearm. Ranged.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Sniper: Enemy Targets get no COVER bonus from attacks with this weapon. Cannot target anything within 4” of the firing character.
Static: Cannot be used if the shooter has moved this turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="a202-996a-d6de-333e" name="“Family Heirloom” MP40" type="upgrade" hidden="false" page="67" publicationId="a21c-395e-03ec-6dcd">
