            <selectionEntry id="ed6b-efc2-70fd-5303" name="Transcendent Beauty" type="upgrade" hidden="false" page="68" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="8" />
              </costs>
              <constraints>
                <constraint id="0411-04aa-3166-269f" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="7a40-cb66-4300-a269" name="Transcendent Beauty" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="68" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Vampire only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, when this Character is targeted by a MELEE ATTACK, it may gain 1 STRESS to reduce the attacker’s dice pool by 2 (to a minimum of 1 die). If the attacker is a COG, it instead suffers −1 Attack for that attack.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
