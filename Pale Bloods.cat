              </costs>
              <constraints>
                <constraint id="925e-4ff1-2603-1181" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="23ad-7460-195d-5b69" name="Nightmare Trinket" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="68" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Enemy Characters within 4″ of this Character suffer −1 POWER. A character can suffer this penalty only once, regardless of how many Nightmare Trinkets are within range.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="8591-a643-da60-6f09" name="Esoteric Tattoos" type="upgrade" hidden="false" page="68" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="15" />
              </costs>
              <constraints>
                <constraint id="ab7e-9003-e8a1-a6d5" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="a320-db7b-1de1-0685" name="Esoteric Tattoos" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="68" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Any [MORTAL] damage dealt by this character’s Innate Weapons are changed to [TRANSCENDENT].</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="4cf6-8848-8a1a-f8ff" name="Tenebrous Predator" type="upgrade" hidden="false" page="68" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="18" />
              </costs>
              <constraints>
                <constraint id="992b-baac-2826-3d22" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="00c2-ab8b-ed6b-13d9" name="Tenebrous Predator" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="68" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Vampire only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When attacking a Character that has already been activated this turn, add + [MORTAL] Potency to the attack.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="6eef-74a9-0ce4-784a" name="Nightmare Predator" type="upgrade" hidden="false" page="74" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="8" />
              </costs>
              <constraints>
                <constraint id="c151-6fb2-312f-8bbb" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="2e57-fdc0-d84f-8426" name="Nightmare Predator" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="74" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Vampire only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This Character gains +2 Velocity when attacking a Character without another Character (excluding this one) within 8”.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="f419-3d15-be45-c646" name="Infected Brood" type="upgrade" hidden="false" page="74" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
              </costs>
              <constraints>
                <constraint id="814e-eb5e-3c1c-27cf" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="e28f-629f-bace-423a" name="Infected Brood" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="74" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When this character is killed, spawn a Chittering Mass COG in base contact with its last position, or as close as possible if there is insufficient space. This COG is controlled by PROGRAM as normal.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="fa1d-9de7-cbb3-f71f" name="Mastery of Shadows" type="upgrade" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="18" />
              </costs>
              <constraints>
                <constraint id="1aaa-9e74-e075-6d01" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="11d4-dc08-77af-3a5b" name="Mastery of Shadows" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Vampire only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This character is Obscured by Darkness when more than 4" from an attacker, rather than 8". While Illuminated, this character cannot remove STRESS, except by performing a FLEE action.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="b3c2-c820-b6fa-0b33" name="Shadow Play" type="upgrade" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
              </costs>
              <constraints>
                <constraint id="b541-a0e7-606c-4ebb" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="b5e8-8641-8863-cf72" name="Shadow Play" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Vampire only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, after an enemy Activation Token is drawn from the Chaos Bag, you may nominate one friendly Character to gain +1 die on its next REFLEX test this turn. A Character can have only one unused bonus from Shadow Play at a time.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="d8cc-dc72-3061-3dc0" name="Corpse Mimicry" type="upgrade" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
              </costs>
              <constraints>
                <constraint id="acb7-5e00-1929-8ce5" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="5029-7b8f-9b20-201a" name="Corpse Mimicry" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Vampire only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per game, after surviving an attack that causes this character to lose VITALITY, it may feign death. Until it next performs an action, COGs cannot target it, and enemy player characters must win an opposed POWER TEST against it before targeting it with an attack. If the test fails, they must choose another target.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="5687-2496-c3cb-78fb" name="Screaming Necklace" type="upgrade" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="12" />
              </costs>
              <constraints>
                <constraint id="1a86-556f-b6d8-920c" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="2fb4-5bfd-0af8-8181" name="Screaming Necklace" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This character gains +1 POWER.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="66bb-c69c-1e69-9cfd" name="Verminous Communion" type="upgrade" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="15" />
              </costs>
              <constraints>
                <constraint id="3fc6-bc4b-53a0-0494" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="d907-5531-2a51-7de1" name="Verminous Communion" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Vampire only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When using an ability that requires Line of Sight, this Character may choose a Friendly Character within 8" of itself and measure range and draw Line of Sight from that Character instead. For any effect that moves a target towards or away from the caster, use the chosen Character as the point of reference. The Character using the ability remains the caster for all other purposes. This does not apply to attacks.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="5a55-84f4-b238-2231" name="Inhuman Alacrity" type="upgrade" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="35" />
              </costs>
              <constraints>
                <constraint id="085b-fa83-d4e9-b07c" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="658e-950a-abf8-0ce6" name="Inhuman Alacrity" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="75" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Vampire only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once during this Character's activation, if it damages an Enemy Character with a MELEE ATTACK, it may lose 2 VITALITY. If it does so, it may make a free SPRINT action. If it ends that movement ENGAGED, it may make a free CHARGE attack as if it had not attacked that turn already. If this movement takes the character out of ENGAGEMENT, it does not resolve a DISENGAGE TEST.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
