                  <characteristics>
                    <characteristic name="Per rank" typeId="3a55-613e-897c-79ee">+1 Resilience</characteristic>
                    <characteristic name="Activation" typeId="bd9c-2947-c24e-331a">Lose 1 Vitality to activate any number of purchased ranks of this boon. Each boon can be activated once per turn. Total active ranks cannot exceed unmodified Power.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry id="4805-0ae6-fe33-abea" name="Stalker" type="model" hidden="false" page="63" publicationId="a21c-395e-03ec-6dcd">
      <categoryLinks>
        <categoryLink id="a104-f72b-1786-c712" name="Characters" targetId="7818-f63f-5020-81d1" primary="true" hidden="false" />
      </categoryLinks>
      <costs>
        <cost name="Influence" typeId="f178-88bc-7258-0c88" value="95" />
      </costs>
      <profiles>
        <profile id="a68d-40d6-38ad-411b" name="Stalker" typeId="7379-d42a-a99d-2084" typeName="Character (base profile)" publicationId="a21c-395e-03ec-6dcd" page="63" hidden="false">
          <characteristics>
            <characteristic name="Speed" typeId="5c3c-1745-c6f4-e1ab">8</characteristic>
            <characteristic name="Might" typeId="6c6c-02be-13ea-abc0">4</characteristic>
            <characteristic name="Finesse" typeId="ac91-114f-a56f-ac40">4</characteristic>
            <characteristic name="Power" typeId="58ce-692d-f1ed-f0d2">3</characteristic>
            <characteristic name="Reflex" typeId="285f-f125-f518-8cd9">3</characteristic>
            <characteristic name="Resilience" typeId="fc73-5c60-9144-ba15">1</characteristic>
            <characteristic name="Vitality" typeId="aa79-6e65-6e8c-b0da">11</characteristic>
            <characteristic name="Traits" typeId="9100-254c-435d-4a59">Vampire.</characteristic>
            <characteristic name="Innate weapons" typeId="5f99-0e22-522c-59bc">Vampire Bite</characteristic>
          </characteristics>
        </profile>
        <profile id="4982-74c7-184a-d846" name="Predatory Leap" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="63" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">If this character makes a CHARGE ATTACK and began its movement at least 4" higher than its target, it gains +2 attack dice for that CHARGE ATTACK.</characteristic>
          </characteristics>
        </profile>
        <profile id="8284-c601-a85a-e7c4" name="Sanguine Vigour" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="63" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">During this character’s activation, or when it is targeted by an attack before any dice are rolled, it may spend 1 VITALITY per Blood Boon to activate its effects until the end of the turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="dbf7-4c37-4467-cc79" name="Uncanny Movement" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="63" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">This character may move over or onto terrain and obstacles up to 4″ higher than its starting surface, ignoring vertical distance when measuring movement. When jumping, this character may jump up to its full Speed during a Move, or double its Speed during a Sprint.</characteristic>
          </characteristics>
        </profile>
        <profile id="7b96-e8c9-52ff-4c8e" name="Heliophobia" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="63" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">When this character suffers any amount of [FIRE] damage, they gain +1 STRESS after resolving the damage.</characteristic>
          </characteristics>
        </profile>
        <profile id="6479-41fa-543f-2620" name="Vampire Bite" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="63" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
            <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
            <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Innate. Melee</characteristic>
            <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Innate: Can never be disarmed.
Life-Steal: Damage dealt by this attack is returned to the attacker as VITALITY, up to the attackers maximum VITALITY.
Blood Sucker: Can target friendly MORTAL Characters. They do not roll Reflex to resist.</characteristic>
          </characteristics>
        </profile>
        <profile id="2288-5c00-e37c-0050" name="Activating Blood Boons" typeId="653c-9eec-114f-7b3e" typeName="Casting" hidden="false" page="65" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Procedure" typeId="a469-c2c4-8dee-eacd">Choose how many purchased ranks of a Blood Boon to activate, then lose 1 Vitality regardless of the number of ranks chosen. This cost ignores Resilience and cannot reduce the Vampire below 1 Vitality. Each Boon can be activated once per turn. Total active ranks across all Boons cannot exceed unmodified Power.</characteristic>
          </characteristics>
        </profile>
      </profiles>
