                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee: 3”.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Reach 3”: Can strike models in MELEE up to 3” away.
Whirlwind: Adds +2 Velocity when targeting multiple Characters.
Cursed: When a roll of 1 is made by this Character in an attack action, this character suffers a [TRANSCENDENT] damage.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup id="cf15-1add-1d39-e0f2" name="Assets" hidden="false">
          <selectionEntries>
            <selectionEntry id="d0ca-cfd3-5be3-dd91" name="Preternatural" type="upgrade" hidden="false" page="68" publicationId="a21c-395e-03ec-6dcd">
              <costs>
