                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Defensive: +1 REFLEX against MELEE attacks.
Skilled: Add your FINESSE stat as Velocity to melee attacks with this weapon.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
