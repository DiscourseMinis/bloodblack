                <profile id="6a91-aa29-a2c9-5c03" name="Brazen Chakram" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="74" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+2</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Ranged. Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Bouncing Blade: Adds +2 Velocity when more than one character is the target of this attack.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="3ee8-d462-6c5f-bc41" name="Torment Urumi" type="upgrade" hidden="false" page="74" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="40" />
              </costs>
              <profiles>
                <profile id="e665-b8f1-223d-250a" name="Torment Urumi" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="74" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+3</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">TRANSCENDENT + TRANSCENDENT</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee: 3”.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Reach 3”: Can strike models in MELEE up to 3” away.
Whirlwind: Adds +2 Velocity when targeting multiple Characters.
Cursed: When a roll of 1 is made by this Character in an attack action, this character suffers a [TRANSCENDENT] damage.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
