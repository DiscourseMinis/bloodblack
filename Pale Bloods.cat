                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">TRANSCENDENT + TRANSCENDENT</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Superiority: Add an additional [TRANSCENDENT] Potency if you have more Power than your target.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="d3ff-c8dc-8b8f-f360" name="Sledgehammer" type="upgrade" hidden="false" page="67" publicationId="a21c-395e-03ec-6dcd">
