              <profiles>
                <profile id="e73d-9513-7ee2-67e3" name="Throwing Knives" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="66" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Ranged: 12”.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Small Weapon: This character may make a free Ranged Attack before making a Sprint or Charge.
Stealth Attack: This weapon adds +2 Velocity when the target of the attack considers this character obscured by darkness.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="9c07-9f71-63ac-fc4f" name="Despoiler Scythe" type="upgrade" hidden="false" page="66" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="18" />
              </costs>
              <profiles>
                <profile id="4c79-7203-b8de-6538" name="Despoiler Scythe" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="66" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+1</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Dominance: When you successfully strike a cowering enemy, you remove all STRESS.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="6dc7-640f-04fe-4ec1" name="Skull Cane" type="upgrade" hidden="false" page="67" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="20" />
              </costs>
              <profiles>
                <profile id="1b5c-d16b-8613-667f" name="Skull Cane" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="67" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">-1</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">TRANSCENDENT + TRANSCENDENT</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Superiority: Add an additional [TRANSCENDENT] Potency if you have more Power than your target.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="14ca-ab49-c6b8-f4ea" name="Sledgehammer" type="upgrade" hidden="false" page="67" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="20" />
              </costs>
              <profiles>
                <profile id="0fca-c2d6-23cb-56f1" name="Sledgehammer" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="67" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">-2</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Massive Swing: If this weapon inflicts a Strike against an Enemy Character, the attack also acts as a SHOVE ACTION. If that SHOVE is stopped by terrain or causes a fall, the target suffers an additional [STUN] [STUN] [STUN]. Resolve this damage as part of the same attack, applying RESILIENCE only once.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="d57b-0810-cdf2-e370" name="Elegant Rapier" type="upgrade" hidden="false" page="67" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="30" />
              </costs>
              <profiles>
                <profile id="d663-6bae-4ee3-b897" name="Elegant Rapier" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="67" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Defensive: +1 REFLEX against MELEE attacks.
Skilled: Add your FINESSE stat as Velocity to melee attacks with this weapon.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="cd31-cdfd-1be3-c6fe" name="Duelling Pistol" type="upgrade" hidden="false" page="70" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="22" />
              </costs>
              <profiles>
                <profile id="79ed-bb81-2f13-6eba" name="Duelling Pistol" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="70" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Ranged: 8”.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">First Blood: This weapon gains +2 Velocity when attacking a Character that has not yet activated this turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="81b2-d76d-13fd-53ef" name="Halberd" type="upgrade" hidden="false" page="70" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="22" />
              </costs>
              <profiles>
                <profile id="424f-b594-2d95-3036" name="Halberd" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="70" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee: 2”.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Reach 2”: Can strike models in MELEE up to 2” away.
Braced: When an enemy makes a CHARGE ATTACK against this Character, this Character may first make a free MELEE ATTACK against that enemy with this weapon and it gains + [MORTAL] POTENCY.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
