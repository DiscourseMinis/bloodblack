              </constraints>
              <profiles>
                <profile id="c185-5023-f29f-67a8" name="Feudal Fealty" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="70" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When this Character would gain STRESS, it may lose 1 VITALITY to transfer all that STRESS to a friendly MORTAL within 8" instead. This cannot reduce the Character below 1 VITALITY.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
