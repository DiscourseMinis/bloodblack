                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This character gains +2 Velocity when attacking a character with a lower POWER.</characteristic>
                  </characteristics>
