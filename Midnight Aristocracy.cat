                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="3dc2-ea87-ea49-8f05" name="Nightmare Trinket" type="upgrade" hidden="false" page="68" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="12" />
              </costs>
              <constraints>
                <constraint id="c69d-b4b0-817b-685a" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="8f42-6500-4547-9e12" name="Nightmare Trinket" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="68" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Enemy Characters within 4″ of this Character suffer −1 POWER. A character can suffer this penalty only once, regardless of how many Nightmare Trinkets are within range.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
