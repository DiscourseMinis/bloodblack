              </constraints>
              <profiles>
                <profile id="5524-091a-9f70-14a7" name="Bloodlust" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="68" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Vampire only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This Character regains 2 VITALITY when it kills an Enemy Character</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="037c-52a4-43ae-1f9e" name="Frenzied Feeder" type="upgrade" hidden="false" page="68" publicationId="a21c-395e-03ec-6dcd">
