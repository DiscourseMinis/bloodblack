        <profile id="7772-b916-532b-bbea" name="Corpseguard" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="64" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Reaction</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">When a friendly VAMPIRE within 4″ is targeted by an attack, before any attack dice are rolled, you may redirect that attack to this character instead. Resolve the attack as though this character occupied the targeted Vampire’s position and this character was targeted by that attack.</characteristic>
          </characteristics>
        </profile>
        <profile id="833d-3389-4988-6b21" name="Live to Serve" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="64" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">If a friendly VAMPIRE is within 8" of this character and in line of sight, then this character suffers no negative modifier to their POWER TEST to activate.</characteristic>
          </characteristics>
        </profile>
        <profile id="34be-ba46-3dd1-77a3" name="Fists" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="64" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
