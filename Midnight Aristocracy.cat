                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Ranged: 8”.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">First Blood: This weapon gains +2 Velocity when attacking a Character that has not yet activated this turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="0843-ef13-6f6e-950b" name="Halberd" type="upgrade" hidden="false" page="70" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="22" />
              </costs>
              <profiles>
                <profile id="2403-0e00-ba83-16c6" name="Halberd" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="70" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee: 2”.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Reach 2”: Can strike models in MELEE up to 2” away.
Braced: When an enemy makes a CHARGE ATTACK against this Character, this Character may first make a free MELEE ATTACK against that enemy with this weapon and it gains + [MORTAL] POTENCY.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="2372-0623-5689-bee0" name="Forgotten Blade" type="upgrade" hidden="false" page="70" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="38" />
              </costs>
              <profiles>
                <profile id="9a15-e4bc-edf2-463c" name="Forgotten Blade" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="70" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
