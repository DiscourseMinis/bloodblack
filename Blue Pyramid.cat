                  <profiles>
                    <profile id="8eb0-ba4d-4e99-1670" name="Compensator" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                      <characteristics>
                        <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Attachment: Firearm</characteristic>
                        <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When attacking with this weapon, count pairs of dice showing the same number in the attack roll. If the attack scores at least one unblocked strike, add an additional [MORTAL] to the total damage for each matching pair of dice (before applying RESILIENCE).</characteristic>
                      </characteristics>
                    </profile>
