              </constraints>
              <profiles>
                <profile id="5c77-5a8c-1b34-b8d3" name="Martial Arts Training" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Advanced.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">For every two successful strikes in a MELEE ATTACK roll, this character gains an additional strike.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="f8a0-1ab0-7eed-d472" name="Grapple Hook" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
