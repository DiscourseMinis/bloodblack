          </characteristics>
        </profile>
        <profile id="e1c3-ee05-b17c-5664" name="Curse of Adam" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="42" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Before rolling any test other than an Activation test, this character may add extra dice, up to its POWER (minus its current STRESS). After resolving the test, it gains 1 STRESS per extra die added.</characteristic>
          </characteristics>
        </profile>
        <profile id="05bd-a6b5-4d65-fa89" name="Fists" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="42" publicationId="a21c-395e-03ec-6dcd">
