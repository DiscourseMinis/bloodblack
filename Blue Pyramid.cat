            <characteristic name="Speed" typeId="5c3c-1745-c6f4-e1ab">6</characteristic>
            <characteristic name="Might" typeId="6c6c-02be-13ea-abc0">3</characteristic>
            <characteristic name="Finesse" typeId="ac91-114f-a56f-ac40">4</characteristic>
            <characteristic name="Power" typeId="58ce-692d-f1ed-f0d2">4</characteristic>
            <characteristic name="Reflex" typeId="285f-f125-f518-8cd9">2</characteristic>
            <characteristic name="Resilience" typeId="fc73-5c60-9144-ba15">0</characteristic>
            <characteristic name="Vitality" typeId="aa79-6e65-6e8c-b0da">8</characteristic>
            <characteristic name="Traits" typeId="9100-254c-435d-4a59">Mortal. Scientist.</characteristic>
            <characteristic name="Innate weapons" typeId="5f99-0e22-522c-59bc">Fists</characteristic>
          </characteristics>
        </profile>
        <profile id="3493-322d-1ca7-860b" name="Drone Operator" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="40" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">When this character successfully activates, choose up to two friendly DRONE characters. In an order of your choice, each may immediately perform one free SIMPLE ACTION. If only one DRONE is chosen, it gains +2 FINESSE during that action. Resolve these actions in an order of your choice.</characteristic>
          </characteristics>
        </profile>
        <profile id="57c5-c348-d722-3262" name="Curse of Adam" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="40" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Before rolling any test other than an Activation test, this character may add extra dice, up to its POWER (minus its current STRESS). After resolving the test, it gains 1 STRESS per extra die added.</characteristic>
          </characteristics>
        </profile>
        <profile id="e559-9ff3-9084-88fa" name="Fists" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="40" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
            <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
            <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Innate. Melee</characteristic>
            <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Innate: Can never be disarmed.</characteristic>
          </characteristics>
        </profile>
      </profiles>
