                        <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Change this weapons Potency to [TRANSCENDENT].</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
              <profiles>
                <profile id="609d-b15b-3de1-7e30" name="The URAEUS" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="49" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+3</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">TRANSCENDENT + TRANSCENDENT + TRANSCENDENT</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Advanced. Firearm. Ranged.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Railgun: If an Enemy Character is in Line of Sight of any friendly character, then this weapon can be fired at that enemy through blocking terrain.
Devastating: Each successful attack die counts as two successes.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
