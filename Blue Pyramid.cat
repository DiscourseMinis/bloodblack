              <constraints>
                <constraint id="9fd2-73f7-21fd-e13c" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="ba15-8415-3809-c3ca" name="Grapple Hook" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This character can perform a Scale Surface action within 4” of a vertical surface as a FREE ACTION. If this character falls while within 4″ of a vertical surface: it ignores any falling damage and is not automatically destroyed by falling double its speed.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="4098-bbe9-1b52-3b96" name="Autopsy Tools" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="8" />
              </costs>
              <constraints>
