              <profiles>
                <profile id="319d-e787-090f-a06f" name="Radio" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Characters equipped with a radio always count as in range and line of sight of other friendly characters equipped with a radio for the purposes of Tactics.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="ab2e-a326-7af8-0386" name="Predictive Modelling" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
