      <profiles>
        <profile id="2a83-f86a-c250-0904" name="UAV" typeId="7379-d42a-a99d-2084" typeName="Character (base profile)" publicationId="a21c-395e-03ec-6dcd" page="41" hidden="false">
          <characteristics>
            <characteristic name="Speed" typeId="5c3c-1745-c6f4-e1ab">10</characteristic>
            <characteristic name="Might" typeId="6c6c-02be-13ea-abc0">1</characteristic>
            <characteristic name="Finesse" typeId="ac91-114f-a56f-ac40">2</characteristic>
            <characteristic name="Power" typeId="58ce-692d-f1ed-f0d2">0</characteristic>
