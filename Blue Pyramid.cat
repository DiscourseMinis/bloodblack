            <characteristic name="Reflex" typeId="285f-f125-f518-8cd9">2</characteristic>
            <characteristic name="Resilience" typeId="fc73-5c60-9144-ba15">0</characteristic>
            <characteristic name="Vitality" typeId="aa79-6e65-6e8c-b0da">8</characteristic>
            <characteristic name="Traits" typeId="9100-254c-435d-4a59">Mortal. Scientist.</characteristic>
            <characteristic name="Innate weapons" typeId="5f99-0e22-522c-59bc">Fists</characteristic>
          </characteristics>
        </profile>
        <profile id="88f9-c0bd-9308-b67e" name="Reassuring Jargon" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="39" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Simple</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Make a POWER TEST (1). If successful: reduce the stress of all unengaged friendly characters within 8” (including this character) by 1.</characteristic>
          </characteristics>
        </profile>
        <profile id="b311-63ee-ab20-da75" name="R&amp;D" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="39" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">This character gains +1 RESILIENCE when being attacked by COGS.</characteristic>
          </characteristics>
        </profile>
        <profile id="280c-b686-4b2d-43f3" name="Curse of Adam" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="39" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Before rolling any test other than an Activation test, this character may add extra dice, up to its POWER (minus its current STRESS). After resolving the test, it gains 1 STRESS per extra die added.</characteristic>
          </characteristics>
        </profile>
        <profile id="9b0e-6b97-e9fe-16ff" name="Fists" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="39" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
            <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
            <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Innate. Melee</characteristic>
            <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Innate: Can never be disarmed.</characteristic>
          </characteristics>
        </profile>
