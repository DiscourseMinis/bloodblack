            <characteristic name="Resilience" typeId="fc73-5c60-9144-ba15">0</characteristic>
            <characteristic name="Vitality" typeId="aa79-6e65-6e8c-b0da">6</characteristic>
            <characteristic name="Traits" typeId="9100-254c-435d-4a59">Electronic. Drone.</characteristic>
            <characteristic name="Innate weapons" typeId="5f99-0e22-522c-59bc">Drone Gun</characteristic>
          </characteristics>
        </profile>
        <profile id="139c-50c4-4b9b-c17c" name="Designate Target" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="41" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Simple</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Make a FINESSE TEST (1). If it succeeds, you may choose a character in Line of Sight and not Obscured by Darkness: that character does not benefit from cover for the rest of this turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="b415-f536-9224-d17c" name="Drone" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="41" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Does not suffer STRESS or take Activation Tests and cannot capture Places of Power. This character can only take Assets and Weapons with the DRONE trait. Does not add an Activation Token to the Chaos Bag. When this character is killed, do not remove an Activation Token from the Chaos Bag. If it has an assigned Activation Token, set that token aside until the next Reset Phase, then return it to the Chaos Bag.</characteristic>
          </characteristics>
        </profile>
        <profile id="cdc2-5937-db48-814c" name="Hover" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="41" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">When moving, this Character may move over or onto terrain and obstacles up to 12″ higher than its starting surface, ignoring vertical distance when measuring movement. It never falls and cannot become ENGAGED.</characteristic>
          </characteristics>
        </profile>
        <profile id="bd42-3267-f17f-70a0" name="Drone Gun" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="41" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+2</characteristic>
            <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
            <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Innate. Ranged.</characteristic>
            <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Innate: Can never be disarmed.</characteristic>
          </characteristics>
        </profile>
      </profiles>
