      <rules>
        <rule id="ffa4-43ca-794e-8fe4" name="Blue Pyramid" hidden="false">
          <description>- May include BLUE PYRAMID Characters and Assets. - All Characters gain the RADIO asset for free.</description>
        </rule>
      </rules>
      <profiles>
        <profile id="691d-e887-3724-3961" name="Operator" typeId="7379-d42a-a99d-2084" typeName="Character (base profile)" publicationId="a21c-395e-03ec-6dcd" page="36" hidden="false">
          <characteristics>
            <characteristic name="Speed" typeId="5c3c-1745-c6f4-e1ab">6</characteristic>
            <characteristic name="Might" typeId="6c6c-02be-13ea-abc0">3</characteristic>
            <characteristic name="Finesse" typeId="ac91-114f-a56f-ac40">4</characteristic>
            <characteristic name="Power" typeId="58ce-692d-f1ed-f0d2">5</characteristic>
            <characteristic name="Reflex" typeId="285f-f125-f518-8cd9">2</characteristic>
            <characteristic name="Resilience" typeId="fc73-5c60-9144-ba15">0</characteristic>
            <characteristic name="Vitality" typeId="aa79-6e65-6e8c-b0da">9</characteristic>
            <characteristic name="Traits" typeId="9100-254c-435d-4a59">Mortal. Leader. Unique.</characteristic>
            <characteristic name="Innate weapons" typeId="5f99-0e22-522c-59bc">Fists</characteristic>
          </characteristics>
        </profile>
        <profile id="9088-a507-aca8-10dd" name="Small Unit Tactics" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="36" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">When this character successfully activates, it may make a POWER TEST (1). If successful, choose up to two other Friendly MORTAL Characters within 8″ that have not activated this turn. Immediately assign each character an Activation Token from the Chaos Bag, then activate them and the OPERATOR one at a time in an order of your choice. Each Character follows the normal activation rules, including making an Activation test.</characteristic>
          </characteristics>
        </profile>
        <profile id="e9e7-c286-fc69-7eda" name="Team Leader Tactics" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="36" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Other friendly Characters within 8” and in line of sight of this character receives +1 die when rolling an Activation Test.</characteristic>
          </characteristics>
        </profile>
        <profile id="cd10-ce3c-3900-ca8c" name="Monster Slayer" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="36" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Gain +1 MIGHT for each other friendly MORTAL character ENGAGED with the Target when making a MELEE ATTACK.</characteristic>
          </characteristics>
        </profile>
        <profile id="55fd-9d5e-cf26-0ff5" name="Curse of Adam" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="36" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Before rolling any test other than an Activation test, this character may add extra dice, up to its POWER (minus its current STRESS). After resolving the test, it gains 1 STRESS per extra die added.</characteristic>
          </characteristics>
        </profile>
        <profile id="e4d8-679b-ca47-34fc" name="Fists" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="36" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
            <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
            <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Innate. Melee</characteristic>
            <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Innate: Can never be disarmed.</characteristic>
          </characteristics>
        </profile>
      </profiles>
