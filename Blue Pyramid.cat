        <profile id="66ea-d8dd-31fe-7aee" name="Expert" typeId="7379-d42a-a99d-2084" typeName="Character (base profile)" publicationId="a21c-395e-03ec-6dcd" page="39" hidden="false">
          <characteristics>
            <characteristic name="Speed" typeId="5c3c-1745-c6f4-e1ab">6</characteristic>
            <characteristic name="Might" typeId="6c6c-02be-13ea-abc0">3</characteristic>
            <characteristic name="Finesse" typeId="ac91-114f-a56f-ac40">3</characteristic>
