              </costs>
              <constraints>
                <constraint id="0677-3453-b946-3e89" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="fdcc-cf3d-2de1-0ee7" name="Spectral Camera" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="48" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">While occupying a Place of Power, this character may perform an INTERACT ACTION to photograph it. This grants the Character +1 POWER for the remainder of the game (to a maximum of +3). Each Place of Power can only be photographed once by this character. After photographing three different Places of Power, it also gains +1 die on REFLEX TESTS.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="a0b8-0421-85db-4697" name="EMF Meter" type="upgrade" hidden="false" page="48" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="12" />
              </costs>
              <constraints>
                <constraint id="7b63-6ba7-a728-3359" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="ab45-3c06-c0b6-acf4" name="EMF Meter" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="48" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per activation, while occupying an INERT Place of Power, this character may perform an INTERACT ACTION to look at the top card of the Dread Deck. Return it to the top or place it on the bottom.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
