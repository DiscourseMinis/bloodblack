      <rules>
        <rule id="1675-99e9-5fde-7351" name="Astral Sorority" hidden="false">
          <description>- May include ASTRAL SORORITY Characters and Assets and perform the STACK THE DECK Black Diablerie. - Once per turn, when any player draws an Activation Token from the Chaos Bag, you may return that token to the bag and draw again.</description>
        </rule>
      </rules>
