              <profiles>
                <profile id="0e75-e3b5-a510-cd4d" name="Blood Drunk" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="73" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Vampire only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This character gains +2 MIGHT while its current Vitality is at least 3 below its maximum VITALITY.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
