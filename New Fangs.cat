                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, when this Character successfully activates, another Friendly Character within 8" may remove 1 STRESS.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
