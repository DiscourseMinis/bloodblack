              </costs>
              <profiles>
                <profile id="7711-9d52-76d1-ce04" name="Despoiler Scythe" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="66" publicationId="a21c-395e-03ec-6dcd">
