        <profile id="89cb-e510-786b-6da8" name="The Flesh is Willing" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="64" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">When a friendly VAMPIRE within 8″ uses Master of Blood, it may pay some or all of the Manifestation’s Blood Cost using this character’s VITALITY instead of its own. Unlike the caster, this character may be reduced to 0 Vitality when paying this cost, killing it.</characteristic>
          </characteristics>
        </profile>
        <profile id="a47f-2108-80b7-4ecb" name="Live to Serve" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="64" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">If a friendly VAMPIRE is within 8" of this character and in line of sight, then this character suffers no negative modifier to their POWER TEST to activate.</characteristic>
          </characteristics>
        </profile>
        <profile id="bda0-111d-2ed3-10ab" name="Fists" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="64" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
