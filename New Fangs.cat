                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+1</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Dominance: When you successfully strike a cowering enemy, you remove all STRESS.</characteristic>
                  </characteristics>
