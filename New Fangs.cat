                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Point-Blank: + [MORTAL] [MORTAL] Potency when firing at a target within 4”.
Poorly Maintained: If you roll a 1 while firing, this gun jams and cannot be fired again until you spend a simple interact action to clear the jam.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="ca7a-4aec-72e4-4eb8" name="Despoiler Scythe" type="upgrade" hidden="false" page="66" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="18" />
              </costs>
              <profiles>
                <profile id="fce7-075c-2d3a-7dfb" name="Despoiler Scythe" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="66" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+1</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Dominance: When you successfully strike a cowering enemy, you remove all STRESS.</characteristic>
                  </characteristics>
