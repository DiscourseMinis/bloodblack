              </constraints>
              <profiles>
                <profile id="e415-2d26-0c2d-411a" name="Adrenaline Junkie" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="73" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Vampire only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, after this Character suffers damage, it may gain 1 STRESS to immediately MOVE up to 4". Resolve the triggering attack or effect fully before moving. If this movement takes the character out of ENGAGEMENT, resolve a DISENGAGE TEST and any resulting enemy free MELEE ATTACKS as normal before moving. This movement cannot generate CHARGE ATTACKS.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
