            </selectionEntry>
            <selectionEntry id="e1e5-b623-b625-f79a" name="Skull Cane" type="upgrade" hidden="false" page="67" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="20" />
              </costs>
              <profiles>
                <profile id="6639-48a2-d3d5-5491" name="Skull Cane" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="67" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
