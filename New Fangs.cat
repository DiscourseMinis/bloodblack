            <selectionEntry id="798e-d3a2-b013-81b7" name="Throwing Knives" type="upgrade" hidden="false" page="66" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="12" />
