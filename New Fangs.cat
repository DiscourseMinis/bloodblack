        <cost name="Influence" typeId="f178-88bc-7258-0c88" value="175" />
      </costs>
      <constraints>
        <constraint id="ea71-774a-7117-9a7e" type="max" value="1" field="selections" scope="force" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
        <constraint id="8b26-d1f8-dbd3-2382" type="min" value="1" field="selections" scope="force" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
      </constraints>
      <rules>
        <rule id="9aaf-1e04-49b0-83d6" name="New Fangs" hidden="false">
          <description>- May include NEW FANG Characters and Assets. - Each VAMPIRE Character may only activate one BLOOD BOON per turn.</description>
        </rule>
      </rules>
      <profiles>
        <profile id="ed70-d020-f005-0dd1" name="Royal" typeId="7379-d42a-a99d-2084" typeName="Character (base profile)" publicationId="a21c-395e-03ec-6dcd" page="58" hidden="false">
          <characteristics>
            <characteristic name="Speed" typeId="5c3c-1745-c6f4-e1ab">7</characteristic>
            <characteristic name="Might" typeId="6c6c-02be-13ea-abc0">6</characteristic>
            <characteristic name="Finesse" typeId="ac91-114f-a56f-ac40">6</characteristic>
            <characteristic name="Power" typeId="58ce-692d-f1ed-f0d2">5</characteristic>
            <characteristic name="Reflex" typeId="285f-f125-f518-8cd9">4</characteristic>
            <characteristic name="Resilience" typeId="fc73-5c60-9144-ba15">2</characteristic>
            <characteristic name="Vitality" typeId="aa79-6e65-6e8c-b0da">15</characteristic>
            <characteristic name="Traits" typeId="9100-254c-435d-4a59">Vampire. Leader. Unique.</characteristic>
            <characteristic name="Innate weapons" typeId="5f99-0e22-522c-59bc">Vampire Bite</characteristic>
          </characteristics>
        </profile>
        <profile id="6338-0019-5894-26b8" name="Destined to Rule" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="58" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Royal Vampires gain a single Aura at Crew Creation depending on their faction:</characteristic>
          </characteristics>
        </profile>
        <profile id="7cf5-a18e-25b8-22f1" name="Alpha Predator’s Aura (New Fangs)" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="58" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Friendly VAMPIRE Characters (including this Character) within 8” gain + [MORTAL] Potency to each Critical Success when attacking in MELEE.</characteristic>
          </characteristics>
        </profile>
        <profile id="c8f5-8151-8da8-f2c2" name="Master of Blood" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="58" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Free</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Once per turn, perform a Bloodphage Manifestation (see Bloodphage Manifestations Page 103).</characteristic>
          </characteristics>
        </profile>
        <profile id="3963-6893-a09d-0a09" name="Sanguine Vigour" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="58" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">During this character’s activation, or when it is targeted by an attack before any dice are rolled, it may spend 1 VITALITY per Blood Boon to activate its effects until the end of the turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="8bd1-a5c9-6228-058a" name="Uncanny Movement" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="58" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">This character may move over or onto terrain and obstacles up to 4″ higher than its starting surface, ignoring vertical distance when measuring movement. When jumping, this character may jump up to its full Speed during a Move, or double its Speed during a Sprint.</characteristic>
          </characteristics>
        </profile>
        <profile id="91b0-d36a-ffb9-7871" name="Heliophobia" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="58" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">When this character suffers any amount of [FIRE] damage, they gain +1 STRESS after resolving the damage.</characteristic>
          </characteristics>
        </profile>
        <profile id="5310-e096-577f-8688" name="Vampire Bite" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="58" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
            <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
            <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Innate. Melee</characteristic>
            <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Innate: Can never be disarmed.
Life-Steal: Damage dealt by this attack is returned to the attacker as VITALITY, up to the attackers maximum VITALITY.
Blood Sucker: Can target friendly MORTAL Characters. They do not roll Reflex to resist.</characteristic>
          </characteristics>
        </profile>
        <profile id="d274-3fb0-968a-7197" name="Activating Blood Boons" typeId="653c-9eec-114f-7b3e" typeName="Casting" hidden="false" page="65" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Procedure" typeId="a469-c2c4-8dee-eacd">Choose how many purchased ranks of a Blood Boon to activate, then lose 1 Vitality regardless of the number of ranks chosen. This cost ignores Resilience and cannot reduce the Vampire below 1 Vitality. Each Boon can be activated once per turn. Total active ranks across all Boons cannot exceed unmodified Power. A New Fangs Vampire may only activate one Blood Boon per turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="2791-5cc1-e442-f399" name="Bloodphage Manifestation" typeId="653c-9eec-114f-7b3e" typeName="Casting" hidden="false" page="103" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Procedure" typeId="a469-c2c4-8dee-eacd">To CAST a Bloodphage Manifestation, the CASTER must choose the MANIFESTATION they want to CAST and any target. Then the CASTER must pay the BLOOD COST by losing that much VITALITY (RESILIENCE cannot reduce this loss). A Character cannot pay a BLOOD COST if it would reduce them below 1 VITALITY. Take a POWER TEST and meet the THRESHOLD. If they succeed, resolve the effects of the MANIFESTATION. If they fail, nothing happens.</characteristic>
          </characteristics>
        </profile>
        <profile id="9f75-d2fd-85a2-93ad" name="Seduce the Blood" typeId="931f-7177-5533-9c2d" typeName="Bloodphage Manifestation" hidden="false" page="103" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="d98c-eda9-0752-9475">Opposed</characteristic>
            <characteristic name="Range" typeId="ab20-9b4e-f2b5-03ba">12”</characteristic>
            <characteristic name="Blood cost" typeId="20e4-eaed-73b1-1a3c">1</characteristic>
            <characteristic name="Effect" typeId="a471-6524-ad50-28f1">Choose an enemy MORTAL within range and Line of Sight that is not ENGAGED. Move the target up to 3″ directly towards the caster, stopping before it enters base contact with another character. This movement follows normal terrain rules, cannot cause a fall and generates no attacks.</characteristic>
          </characteristics>
        </profile>
        <profile id="7e65-0654-5aa9-db86" name="Hypnotic Gaze" typeId="931f-7177-5533-9c2d" typeName="Bloodphage Manifestation" hidden="false" page="103" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="d98c-eda9-0752-9475">Opposed</characteristic>
            <characteristic name="Range" typeId="ab20-9b4e-f2b5-03ba">12”</characteristic>
            <characteristic name="Blood cost" typeId="20e4-eaed-73b1-1a3c">1</characteristic>
            <characteristic name="Effect" typeId="a471-6524-ad50-28f1">Choose an Enemy Character within range and Line of Sight. The target cannot take REACTIONS until the end of the caster’s activation.</characteristic>
          </characteristics>
        </profile>
        <profile id="4737-2edc-e12b-4478" name="Let Me In" typeId="931f-7177-5533-9c2d" typeName="Bloodphage Manifestation" hidden="false" page="103" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="d98c-eda9-0752-9475">Opposed</characteristic>
            <characteristic name="Range" typeId="ab20-9b4e-f2b5-03ba">6”</characteristic>
            <characteristic name="Blood cost" typeId="20e4-eaed-73b1-1a3c">1</characteristic>
            <characteristic name="Effect" typeId="a471-6524-ad50-28f1">Choose an enemy MORTAL within range and Line of Sight. Place the caster within 1″ of the target, in a legal position outside base contact with any enemy. This placement generates no attacks. The caster cannot use this Manifestation while ENGAGED.</characteristic>
          </characteristics>
        </profile>
        <profile id="35ec-746a-f376-584a" name="Entrancement" typeId="931f-7177-5533-9c2d" typeName="Bloodphage Manifestation" hidden="false" page="103" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="d98c-eda9-0752-9475">Opposed</characteristic>
            <characteristic name="Range" typeId="ab20-9b4e-f2b5-03ba">12”</characteristic>
            <characteristic name="Blood cost" typeId="20e4-eaed-73b1-1a3c">1</characteristic>
            <characteristic name="Effect" typeId="a471-6524-ad50-28f1">Choose an enemy MORTAL within range and Line of Sight. The target cannot ATTACK the caster until the end of the turn. This effect ends immediately if the caster declares an attack against any character in the target’s crew, or causes any character in that crew to lose VITALITY.</characteristic>
          </characteristics>
        </profile>
        <profile id="a99d-df89-757d-b313" name="Heart Explosion" typeId="931f-7177-5533-9c2d" typeName="Bloodphage Manifestation" hidden="false" page="103" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="d98c-eda9-0752-9475">Opposed</characteristic>
            <characteristic name="Range" typeId="ab20-9b4e-f2b5-03ba">6”</characteristic>
            <characteristic name="Blood cost" typeId="20e4-eaed-73b1-1a3c">2</characteristic>
            <characteristic name="Effect" typeId="a471-6524-ad50-28f1">Choose an enemy MORTAL within range and Line of Sight. If successful, the target loses 2 VITALITY, ignoring RESILIENCE. If this kills the target, the caster recovers 2 VITALITY.</characteristic>
          </characteristics>
        </profile>
        <profile id="43bf-f35d-decf-2641" name="Mist Form" typeId="931f-7177-5533-9c2d" typeName="Bloodphage Manifestation" hidden="false" page="103" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="d98c-eda9-0752-9475">Opposed</characteristic>
            <characteristic name="Range" typeId="ab20-9b4e-f2b5-03ba">Self</characteristic>
            <characteristic name="Blood cost" typeId="20e4-eaed-73b1-1a3c">1</characteristic>
            <characteristic name="Effect" typeId="a471-6524-ad50-28f1">Immediately move the caster up to 3″, passing through terrain and other Characters. It may leave ENGAGEMENT without triggering a REFLEX TEST, but must finish in a legal position outside base contact with any enemy. The caster then reforms and may continue its activation normally.</characteristic>
          </characteristics>
        </profile>
      </profiles>
