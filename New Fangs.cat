        <categoryLink id="f9c3-8a52-e553-6fdd" name="Characters" targetId="7818-f63f-5020-81d1" primary="true" hidden="false" />
      </categoryLinks>
      <costs>
        <cost name="Influence" typeId="f178-88bc-7258-0c88" value="115" />
      </costs>
      <profiles>
        <profile id="6a61-e5ac-6921-9e9c" name="Gladiator" typeId="7379-d42a-a99d-2084" typeName="Character (base profile)" publicationId="a21c-395e-03ec-6dcd" page="62" hidden="false">
          <characteristics>
            <characteristic name="Speed" typeId="5c3c-1745-c6f4-e1ab">7</characteristic>
            <characteristic name="Might" typeId="6c6c-02be-13ea-abc0">4</characteristic>
            <characteristic name="Finesse" typeId="ac91-114f-a56f-ac40">4</characteristic>
            <characteristic name="Power" typeId="58ce-692d-f1ed-f0d2">4</characteristic>
            <characteristic name="Reflex" typeId="285f-f125-f518-8cd9">3</characteristic>
            <characteristic name="Resilience" typeId="fc73-5c60-9144-ba15">1</characteristic>
            <characteristic name="Vitality" typeId="aa79-6e65-6e8c-b0da">11</characteristic>
            <characteristic name="Traits" typeId="9100-254c-435d-4a59">Vampire.</characteristic>
            <characteristic name="Innate weapons" typeId="5f99-0e22-522c-59bc">Vampire Bite</characteristic>
          </characteristics>
        </profile>
        <profile id="2276-5bc5-d052-1b1b" name="Immortal Duellist" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="62" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Free</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Once during this character’s activation, if it makes a MELEE ATTACK with a weapon and scores at least one unblocked Success, it may make an additional free MELEE ATTACK with another weapon (even after an attack generated by a Charge).</characteristic>
          </characteristics>
        </profile>
        <profile id="5d86-b66d-2829-4716" name="Sanguine Vigour" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="62" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">During this character’s activation, or when it is targeted by an attack before any dice are rolled, it may spend 1 VITALITY per Blood Boon to activate its effects until the end of the turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="605d-46b8-dc03-da0b" name="Uncanny Movement" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="62" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">This character may move over or onto terrain and obstacles up to 4″ higher than its starting surface, ignoring vertical distance when measuring movement. When jumping, this character may jump up to its full Speed during a Move, or double its Speed during a Sprint.</characteristic>
          </characteristics>
        </profile>
        <profile id="6740-612e-e0e4-e042" name="Heliophobia" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="62" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">When this character suffers any amount of [FIRE] damage, they gain +1 STRESS after resolving the damage.</characteristic>
          </characteristics>
        </profile>
        <profile id="4a1a-22f1-d8b7-a02b" name="Vampire Bite" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="62" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
            <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
            <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Innate. Melee</characteristic>
            <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Innate: Can never be disarmed.
Life-Steal: Damage dealt by this attack is returned to the attacker as VITALITY, up to the attackers maximum VITALITY.
Blood Sucker: Can target friendly MORTAL Characters. They do not roll Reflex to resist.</characteristic>
          </characteristics>
        </profile>
        <profile id="73df-01b7-330f-0e66" name="Activating Blood Boons" typeId="653c-9eec-114f-7b3e" typeName="Casting" hidden="false" page="65" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Procedure" typeId="a469-c2c4-8dee-eacd">Choose how many purchased ranks of a Blood Boon to activate, then lose 1 Vitality regardless of the number of ranks chosen. This cost ignores Resilience and cannot reduce the Vampire below 1 Vitality. Each Boon can be activated once per turn. Total active ranks across all Boons cannot exceed unmodified Power. A New Fangs Vampire may only activate one Blood Boon per turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
