              <profiles>
                <profile id="cbf0-3af8-e754-f3d2" name="Throwing Knives" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="66" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Ranged: 12”.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Small Weapon: This character may make a free Ranged Attack before making a Sprint or Charge.
Stealth Attack: This weapon adds +2 Velocity when the target of the attack considers this character obscured by darkness.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="2723-51ed-1c97-9b3a" name="Old Shotgun" type="upgrade" hidden="false" page="66" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="14" />
              </costs>
              <profiles>
                <profile id="ea3c-85ad-d953-870b" name="Old Shotgun" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="66" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Firearm. Ranged.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Point-Blank: + [MORTAL] [MORTAL] Potency when firing at a target within 4”.
Poorly Maintained: If you roll a 1 while firing, this gun jams and cannot be fired again until you spend a simple interact action to clear the jam.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="c178-d37a-971d-26d3" name="Despoiler Scythe" type="upgrade" hidden="false" page="66" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="18" />
              </costs>
              <profiles>
                <profile id="53d7-a99b-a148-e6d7" name="Despoiler Scythe" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="66" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+1</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Dominance: When you successfully strike a cowering enemy, you remove all STRESS.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="029f-da16-8769-8c8f" name="Skull Cane" type="upgrade" hidden="false" page="67" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="20" />
              </costs>
              <profiles>
                <profile id="10fe-fbb9-9640-5f44" name="Skull Cane" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="67" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">-1</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">TRANSCENDENT + TRANSCENDENT</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Superiority: Add an additional [TRANSCENDENT] Potency if you have more Power than your target.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="f36a-47e1-a658-8232" name="Sledgehammer" type="upgrade" hidden="false" page="67" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="20" />
              </costs>
              <profiles>
                <profile id="1458-ffd8-ba70-f113" name="Sledgehammer" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="67" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">-2</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Massive Swing: If this weapon inflicts a Strike against an Enemy Character, the attack also acts as a SHOVE ACTION. If that SHOVE is stopped by terrain or causes a fall, the target suffers an additional [STUN] [STUN] [STUN]. Resolve this damage as part of the same attack, applying RESILIENCE only once.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="9244-4c35-eb42-045c" name="Hunting Rifle" type="upgrade" hidden="false" page="67" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="28" />
              </costs>
              <profiles>
                <profile id="6a1e-aa5e-3179-8287" name="Hunting Rifle" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="67" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+2</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Firearm. Ranged.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Sniper: Enemy Targets get no COVER bonus from attacks with this weapon. Cannot target anything within 4” of the firing character.
Static: Cannot be used if the shooter has moved this turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="1897-8516-1b25-f99d" name="“Family Heirloom” MP40" type="upgrade" hidden="false" page="67" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="30" />
              </costs>
              <profiles>
                <profile id="13a2-524d-7e59-1405" name="“Family Heirloom” MP40" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="67" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+3</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
