              </constraints>
              <profiles>
                <profile id="7b66-f96c-10fd-67c1" name="Initiation Brand" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="96" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Mortal only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Gain +1 die to Activation Tests while within 6” of a friendly WITCH.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="0848-74ce-6fc6-221e" name="Animal Mask" type="upgrade" hidden="false" page="96" publicationId="a21c-395e-03ec-6dcd">
