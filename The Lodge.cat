<?xml version='1.0' encoding='utf-8'?>
<catalogue id="1b1f-bfc9-f5fc-d2cd" name="The Lodge" revision="2" battleScribeVersion="2.03" gameSystemId="1029-fba5-6af2-96d8" gameSystemRevision="2" library="false" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <selectionEntries>
    <selectionEntry id="b247-feeb-3d2d-f4ca" name="Hierophant" type="model" hidden="false" page="80" publicationId="a21c-395e-03ec-6dcd">
      <categoryLinks>
        <categoryLink id="5069-92f3-4b16-0220" name="Characters" targetId="7818-f63f-5020-81d1" primary="true" hidden="false" />
      </categoryLinks>
      <costs>
        <cost name="Influence" typeId="f178-88bc-7258-0c88" value="105" />
      </costs>
      <constraints>
        <constraint id="9ecc-3ac0-c0c2-e188" type="max" value="1" field="selections" scope="force" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
        <constraint id="1f87-b85e-c462-eac7" type="min" value="1" field="selections" scope="force" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
      </constraints>
      <rules>
        <rule id="b5f7-9730-477f-5be7" name="The Lodge" hidden="false">
          <description>- May include THE LODGE Characters and Assets and perform the UNDER HUNGRY BOUGHS Black Diablerie. - When a friendly MORTAL character dies within 8” of a friendly WITCH character, that WITCH gains a permanent +1 POWER (to a maximum bonus of +3 Power from this rule).</description>
        </rule>
      </rules>
      <profiles>
        <profile id="ace5-7597-8158-8668" name="Hierophant" typeId="7379-d42a-a99d-2084" typeName="Character (base profile)" publicationId="a21c-395e-03ec-6dcd" page="80" hidden="false">
          <characteristics>
            <characteristic name="Speed" typeId="5c3c-1745-c6f4-e1ab">6</characteristic>
            <characteristic name="Might" typeId="6c6c-02be-13ea-abc0">3</characteristic>
            <characteristic name="Finesse" typeId="ac91-114f-a56f-ac40">3</characteristic>
            <characteristic name="Power" typeId="58ce-692d-f1ed-f0d2">7</characteristic>
            <characteristic name="Reflex" typeId="285f-f125-f518-8cd9">2</characteristic>
            <characteristic name="Resilience" typeId="fc73-5c60-9144-ba15">0</characteristic>
            <characteristic name="Vitality" typeId="aa79-6e65-6e8c-b0da">9</characteristic>
            <characteristic name="Traits" typeId="9100-254c-435d-4a59">Witch. Unique.</characteristic>
            <characteristic name="Innate weapons" typeId="5f99-0e22-522c-59bc">Fists</characteristic>
          </characteristics>
        </profile>
        <profile id="95b4-81f3-a6ee-710d" name="The First To Disobey" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="80" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Complex</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">If this Character is within 3” of a Place of Power and is not ENGAGED, it may take a COMPLEX ACTION to cast a BLACK DIABLERIE, following the rules of BLACK DIABLERIE on Page 100.</characteristic>
          </characteristics>
        </profile>
        <profile id="b85d-6a0d-ef57-a944" name="The Shade That Trees Spit Out" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="80" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Simple</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">If this character is not Engaged with an enemy character, it may take a Simple Action to cast a spell from the Blasphemous Sorcery list. After resolving the casting attempt and any spell effects, this character gains 1 STRESS, whether the spell succeeded or failed.</characteristic>
          </characteristics>
        </profile>
        <profile id="ee62-d891-fcda-3cc8" name="The Devil Has Spoken, Doubt Is Sacrilege" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="80" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Simple</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">If this character is not ENGAGED with an enemy character, it may take a SIMPLE ACTION to cast a spell from the Blasphemous Sorcery list. After resolving the casting attempt and any spell effects, this character gains 1 STRESS, whether the spell succeeded or failed.</characteristic>
          </characteristics>
        </profile>
        <profile id="e115-3221-9d8c-d1ce" name="Magician" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="80" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Simple</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">If this character is not ENGAGED, it may take a SIMPLE ACTION to cast a spell from the Blasphemous Sorcery list on Page 102. After resolving the casting attempt and any spell effects, this character gains 1 STRESS, whether the spell succeeded or failed.</characteristic>
          </characteristics>
        </profile>
        <profile id="263f-1fc9-97e7-e2f3" name="Fists" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="80" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
            <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
            <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Innate. Melee</characteristic>
            <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Innate: Can never be disarmed.</characteristic>
          </characteristics>
        </profile>
        <profile id="adc7-a185-f5f3-6753" name="Blasphemous Sorcery" typeId="653c-9eec-114f-7b3e" typeName="Casting" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Procedure" typeId="a469-c2c4-8dee-eacd">To CAST a Blasphemous Sorcery, the CASTER must choose the SPELL they want to CAST and any target. Then take a POWER TEST and meet the THRESHOLD. If they succeed, resolve the effects of the SPELL. If they fail, nothing happens. SPELLS are ALWAYS resisted, even if cast on a friendly Character.</characteristic>
          </characteristics>
        </profile>
        <profile id="873c-9884-a168-74af" name="Otherworldly Pact" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">1</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">12”</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Choose a Character within range and Line of Sight. The Target loses 1 VITALITY. Then it gains +1 die on its next roll for each success scored on the casting test, to a maximum of +3 dice. A character can have only one unused Otherworldly Pact bonus at a time; a new bonus replaces the previous one rather than stacking.</characteristic>
          </characteristics>
        </profile>
        <profile id="8f71-230b-0542-29c9" name="Glimpse The Code" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">1</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">~</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Look at the top card of the DREAD DECK, you may then place it at the top or bottom of the deck.</characteristic>
          </characteristics>
        </profile>
        <profile id="364f-c3dc-0810-5118" name="Dead Man’s Steps" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">2</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">12”</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Choose a point within range and Line of Sight of the caster. Every unengaged COG within 12″ of that point that cannot currently detect an eligible Player Character immediately moves up to its Speed towards it, stopping upon reaching it. This movement cannot generate attacks or free CHARGE attacks. Each COG can only be moved by this spell once per turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="bfc3-a06b-c479-4761" name="World Without Doors" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">1</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">Self</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Move the casting Character to anywhere within 18” and line-of-sight.</characteristic>
          </characteristics>
        </profile>
        <profile id="31f6-5abb-1e12-d56b" name="Calcify" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">Opposed</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">12”</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Choose a Character within range and Line of Sight. If successful, the target gains +4 RESILIENCE but cannot take any actions until the end of the turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="4ab9-c350-6181-9d5f" name="Wither" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">Opposed</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">12”</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Choose an Enemy Character within range and Line of Sight. If successful, the Target suffers 1 STRESS, plus 1 additional STRESS for each unblocked success.</characteristic>
          </characteristics>
        </profile>
        <profile id="ec0d-1020-178e-dfd6" name="Phantom Razor" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">Opposed</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">12”</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Choose an Enemy Character within range and Line of Sight. If successful, the target suffers 1 STRESS, then suffers [TRANSCENDENT] DAMAGE equal to its current STRESS. Then remove all STRESS from the target.</characteristic>
          </characteristics>
        </profile>
        <profile id="9ba3-ca7a-f3e7-01c3" name="Witchfire" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">Opposed</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">8”</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Choose an Enemy Character within range and Line of Sight. If successful, inflict [FIRE] DAMAGE on the target per unblocked success. This spell does not illuminate the caster.</characteristic>
          </characteristics>
        </profile>
        <profile id="7fc8-4a95-e20b-a321" name="Black Diablerie" typeId="653c-9eec-114f-7b3e" typeName="Casting" hidden="false" page="100" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Procedure" typeId="a469-c2c4-8dee-eacd">To CAST a Black Diablerie, the CASTER must choose the BLACK DIABLERIE they want to CAST and then suffer 1 STRESS. Then take a POWER TEST and meet the THRESHOLD. If they FAIL, nothing happens. If they SUCCEED, add one DIABLERIE TOKEN to the Chaos Bag. The Caster is now CASTING. Record the caster and the chosen ritual. Any additional Diablerie Tokens generated by abilities or assets belong to the same caster and ritual. When a DIABLERIE TOKEN is drawn from the Chaos Bag, resolve the chosen BLACK DIABLERIE’S effect immediately, making any required choices and selecting targets at this point unless the ritual states otherwise. Remove any remaining Diablerie Tokens belonging to that ritual from the Chaos Bag. The caster ceases Casting, and the Coven cannot attempt another BLACK DIABLERIE this turn. If the Caster is KILLED while CASTING, the ritual fails. Immediately remove all its DIABLERIE TOKENS from the Chaos Bag. The caster ceases CASTING, and the ritual has no effect.</characteristic>
          </characteristics>
        </profile>
        <profile id="600c-49d3-be1b-0259" name="Under Hungry Boughs" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="100" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">3</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">Choose a friendly WITCH with an assigned Activation Token and a friendly MORTAL without one. Transfer the WITCH’S Activation Token to the Mortal, who immediately activates following the normal Activation rules, including making an Activation Test. The WITCH no longer has an assigned Activation Token and is eligible to activate again this turn. Any ongoing Cower or Vigil benefits associated with the transferred token end.</characteristic>
          </characteristics>
        </profile>
        <profile id="ad2f-81e3-7e3c-32cc" name="Rite of the Coiling Dragon" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="100" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">2</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">Friendly Characters without an Activation Token assigned count as if they took COWER reactions when they are attacked this turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="e357-b7a2-88b6-79c1" name="We Who Work For Principalities And Dark Places" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="100" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">2</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">Friendly MORTAL Characters gain 1 STRESS. Friendly DEVIL Characters recover 3 VITALITY.</characteristic>
          </characteristics>
        </profile>
        <profile id="1988-a1cc-3350-7b08" name="Deception From A Serpent’s Mind" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="100" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">2</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">Choose an Enemy Character within range and Line of Sight. If successful, the Target suffers 1 STRESS, plus 1 additional STRESS for each unblocked success.</characteristic>
          </characteristics>
        </profile>
        <profile id="7e1a-7807-15e7-8b56" name="The Light Of Dead Angels" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="100" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">2</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">Choose a Character. For the rest of the game, that Character ignores the Night rule when making attacks. This effect does not make the character Illuminated.</characteristic>
          </characteristics>
        </profile>
        <profile id="f882-a1bb-522c-0853" name="The Mindless Flutes Of An Idiot God" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="101" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">2</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">Choose up to 2 Activation Tokens already assigned to Characters and return them to the Chaos Bag. Each affected Character becomes eligible to activate again this turn, and any ongoing COWER or VIGIL benefits associated with its returned token end. No further spell can be cast by the Coven player this turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="9ec0-5cd7-eade-b60c" name="Asmoday’s Gift" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="101" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">2</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">All friendly DEVIL Characters with Activation Tokens assigned to them (including PROGRAM Activation Tokens) can make a single SIMPLE ACTION.</characteristic>
          </characteristics>
        </profile>
        <profile id="3c8c-a87b-489e-8991" name="Weigh The Soul" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="101" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">2</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">Remove a random Activation Token from the Chaos Bag. The Coven player then decides if it is returned to the Chaos bag, or set aside out of play until the end of the RESET PHASE.</characteristic>
          </characteristics>
        </profile>
        <profile id="a88b-d9fd-d17c-e6fe" name="Grasp The Left Hand" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="101" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">3</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">Reveal the next Activation Token drawn from the Chaos Bag and resolve it as follows:
- Enemy crew token: You may assign the token to an eligible Character from that crew and control it for this activation. Resolve its activation normally, including any required Activation Test. Until the activation ends, it treats your crew as friendly and the other Characters in its own crew as enemies.
- PROGRAM token: Choose one eligible COG. When it activates, you control it for that activation. It may perform two actions, each either a Move or an Attack, in any order. You choose its movement and legal targets, using its normal profile and attack rules. All other eligible COGs activate normally.</characteristic>
          </characteristics>
        </profile>
        <profile id="dffe-bd32-386b-81b7" name="Both Beast And Angel" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="101" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">3</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">All Friendly MORTAL and WITCH Characters permanently gain +1 FINESSE.</characteristic>
          </characteristics>
        </profile>
        <profile id="d646-bee5-35e3-6344" name="The Most Blasphemous Curse" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="101" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">4</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">Reverse the status of every Place of Power on the battlefield: ACTIVE Places become INERT, and INERT Places become ACTIVE. Every Character occupying a Place of Power immediately gains 2 STRESS and is PUSHED 3" directly away from it.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntryGroups>
        <selectionEntryGroup id="65f8-de28-09af-8d04" name="Weapons" hidden="false">
          <selectionEntries>
            <selectionEntry id="e18d-132b-dc18-3651" name="Club" type="upgrade" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="5" />
              </costs>
              <profiles>
                <profile id="bf7b-09af-c6ea-a296" name="Club" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">—</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="5641-c6d2-99b6-5eb0" name="Ghost Box" type="upgrade" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
              </costs>
              <profiles>
                <profile id="c358-3e7b-1b34-963b" name="Ghost Box" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">STUN</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Ranged: 8”.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Unearthly Frequency: When making an attack with this weapon, if your attack roll contains two or more dice showing the same result, you may change its Potency to [TRANSCENDENT].
Ineffable Tool: You must use your Power stat in place of Might/Finesse when making a melee/ranged attack with this weapon.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="0b2b-23c6-b02f-1eae" name="Gleaming Athame" type="upgrade" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="17" />
              </costs>
              <profiles>
                <profile id="37e7-0848-8955-63dd" name="Gleaming Athame" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+4</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Sever the Soul: Every 3rd successful Strike gains 1 [TRANSCENDENT] Potency damage.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="b612-658b-e04f-5e8d" name="Uzi" type="upgrade" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="18" />
              </costs>
              <profiles>
                <profile id="2d97-1343-21bc-0fed" name="Uzi" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+2</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Firearm. Ranged.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Hip Fire: +2 Velocity when firing at a target within 4″, but suffers −2 Velocity when firing at a target more than 8″ away.
Compact: While ENGAGED, this Character may make RANGED ATTACKS with this weapon, but only against Enemy Characters they are ENGAGED with.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="1ef6-9b3b-a64d-12c9" name="Soul Stealer" type="upgrade" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="20" />
              </costs>
              <profiles>
                <profile id="ebc2-d81f-d703-06da" name="Soul Stealer" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+3</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">TRANSCENDENT</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Sup Well: When this weapon deals the killing blow, it permanelty gains + [TRANSCENDENT] Potency.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="f754-239c-6a78-e86c" name="Reverse-Path Rifle" type="upgrade" hidden="false" page="89" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="24" />
              </costs>
              <profiles>
                <profile id="398f-b017-ba21-cf99" name="Reverse-Path Rifle" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="89" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+2</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">TRANSCENDENT</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Firearm. Ranged.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Mirrored Bullets: When firing at a target in cover, that target suffers −2 REFLEX instead of the usual +2 cover bonus. Against a COG in cover, apply −1 DEFENSE instead of the usual +1 DEFENSE bonus. When firing at a target without cover, that target gains +2 REFLEX, or +1 DEFENSE if it is a COG.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="69ac-e991-38b6-b6dd" name="Accursed Flute" type="upgrade" hidden="false" page="89" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="25" />
              </costs>
              <profiles>
                <profile id="277e-3f25-8679-609d" name="Accursed Flute" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="89" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+4</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">TRANSCENDENT + TRANSCENDENT</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Forbidden. Ranged.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Pulse 8”: Area attack centred on the attacker; radius 8”.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
