        <profile id="b08e-38e4-9a91-0b68" name="Eyes of the Coven" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="86" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">When a friendly WITCH casts a Spell, she may measure the Spell’s Range and draw Line of Sight from this Character instead of herself.</characteristic>
          </characteristics>
        </profile>
        <profile id="9692-81be-2e5b-8642" name="Hover" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="86" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">When moving, this Character may move over or onto terrain and obstacles up to 12″ higher than its starting surface, ignoring vertical distance when measuring movement. It never falls and cannot become ENGAGED.</characteristic>
          </characteristics>
        </profile>
        <profile id="3b77-3f2a-1680-6943" name="From Outside" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="86" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Does not suffer STRESS or take Activation Tests and cannot capture Places of Power. This character can only take Assets and Weapons with the LILITH’S GIFT trait. Does not add an Activation Token to the Chaos Bag. When this character is killed, do not remove an Activation Token from the Chaos Bag. If it has an assigned Activation Token, set that token aside until the next Reset Phase, then return it to the Chaos Bag.</characteristic>
          </characteristics>
        </profile>
      </profiles>
