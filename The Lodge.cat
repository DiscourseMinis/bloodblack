              </constraints>
              <profiles>
                <profile id="981c-7d39-cf26-97b7" name="Abyssal Rod" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Enemy Characters within 8″ of this Character suffer −1 die on tests made to perform or resolve ACTIONS. Enemy COGs within 8″ of this character instead suffer −1 ATTACK when attacking.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="60f1-7fa9-700c-62e7" name="Bloody Broomstick" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="15" />
              </costs>
              <constraints>
                <constraint id="cbf4-e09e-16df-b052" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="083f-124a-a695-342d" name="Bloody Broomstick" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This character may move over or onto terrain and obstacles up to 6″ higher than its starting surface, ignoring vertical distance when measuring movement. When jumping, this character may jump up to its full Speed during a Move, or double its Speed during a Sprint.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="177d-d259-6141-fc49" name="Grave Wax Candle" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
