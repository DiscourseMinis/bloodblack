              <profiles>
                <profile id="ab60-8bde-43ac-24c6" name="The Fool: 0" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Critical Success rolls on REFLEX TESTS count as two successes.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="6878-f7cd-816f-6b84" name="Haemonculus Fetish" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
              </costs>
              <constraints>
                <constraint id="2b9f-f950-1ef8-567c" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="8ae3-0e7c-1ee7-598a" name="Haemonculus Fetish" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Gain +1 REFLEX per STRESS on this character (to a maximum of +4).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="cc53-0aa8-f853-db24" name="Apple of Eden" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
              </costs>
              <constraints>
                <constraint id="78e1-56fb-5585-8935" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="d302-b273-ddcc-74d8" name="Apple of Eden" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, after this character fails its first Cast Black Diablerie test of the turn and gains the normal STRESS from casting, it may immediately end its activation and return its Activation Token to the Chaos Bag. It becomes eligible to activate again this turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="a874-69ff-805d-af30" name="Doppelganger’s Finger" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
              </costs>
              <constraints>
                <constraint id="8994-710f-5d7d-3a9a" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="85c2-4c6c-4d01-8446" name="Doppelganger’s Finger" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When you would add a Coven Diablerie Token to the Chaos Bag, add another for the same caster and chosen Black Diablerie. Both tokens belong to that single ritual.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="85c6-04d5-cebb-f5b6" name="Haunted Doll" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="12" />
              </costs>
              <constraints>
                <constraint id="1efb-43b8-54b5-e43e" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="5b0c-bcad-c789-6934" name="Haunted Doll" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">The first time you would gain STRESS each turn, you may choose not to.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="fbe9-53c5-040c-f02f" name="Abyssal Rod" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="13" />
              </costs>
              <constraints>
                <constraint id="3a0d-a12c-5389-335f" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="c4a2-994b-5981-bcb6" name="Abyssal Rod" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Enemy Characters within 8″ of this Character suffer −1 die on tests made to perform or resolve ACTIONS. Enemy COGs within 8″ of this character instead suffer −1 ATTACK when attacking.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="cb73-6604-38c9-89e1" name="Bloody Broomstick" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="15" />
              </costs>
              <constraints>
                <constraint id="ed76-e257-8f8e-ff61" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="7511-be53-ccbe-fbbc" name="Bloody Broomstick" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This character may move over or onto terrain and obstacles up to 6″ higher than its starting surface, ignoring vertical distance when measuring movement. When jumping, this character may jump up to its full Speed during a Move, or double its Speed during a Sprint.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="d6e8-548c-1e52-a6b0" name="Grave Wax Candle" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="15" />
              </costs>
              <constraints>
                <constraint id="1d42-f110-3d77-45db" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="f217-ba2f-a3fe-1414" name="Grave Wax Candle" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When assembling a POWER test to cast Blasphemous Sorcery or Black Diablerie, this character may light the candle. If it does, it counts as Illuminated until the end of the turn and adds +1 die to the test. If casting through Magician, it does not gain the Stress normally caused by that ability.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="dc8a-61c1-ae2a-838d" name="Black Mirror" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="15" />
              </costs>
              <constraints>
                <constraint id="1294-a3d9-9c1b-ec4a" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="b325-6462-86dc-a367" name="Black Mirror" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">At the start of this character’s activation, it may teleport up to 12″ as a FREE ACTION, without requiring Line of Sight. Place it in a legal position. At the end of that activation, return it to its starting position. If that position is occupied or otherwise illegal, place it as close as possible in a legal position. Both teleports may take this character into or out of ENGAGEMENT, but do not generate CHARGE attacks or free attacks for DISENGAGING.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="e8a1-4342-f3ef-f229" name="Willow Pendant" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="15" />
              </costs>
              <constraints>
                <constraint id="65f7-8b56-31d3-7b36" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="01d0-17ab-1a04-30b1" name="Willow Pendant" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">While this Character occupies a Place of Power, it gains +2 POWER.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="32ea-7cc9-f21f-e9df" name="Solomon’s Ring" type="upgrade" hidden="false" page="91" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="15" />
              </costs>
              <constraints>
                <constraint id="4e4d-681c-ff25-b243" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="dd3b-1e00-c156-6fc6" name="Solomon’s Ring" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="91" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When this character successfully activates, choose a friendly DEVIL character within 13”. That DEVIL may immediately perform one free SIMPLE ACTION.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="44cd-f99d-d136-2cfb" name="Hearthstone Talisman" type="upgrade" hidden="false" page="91" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="18" />
              </costs>
              <constraints>
                <constraint id="db57-a736-bf2d-2188" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="5962-7397-7f2b-901a" name="Hearthstone Talisman" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="91" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This Character gains +3 VITALITY.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
