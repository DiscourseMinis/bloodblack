              </constraints>
              <profiles>
                <profile id="471e-cfdf-78c1-1538" name="Ascension Vest" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="97" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Mortal only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per game, during their activation, this Character may choose to Ascend as a SIMPLE ACTION. If they do, each other Character within 2″ makes a REFLEX TEST. Each suffers 5 [MORTAL] damage, reduced by 1 for each success on its own test, to a minimum of 0. Apply RESILIENCE to the remaining damage as normal. After resolving the damage against all affected Characters, the wearer is killed.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
