                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Mortal only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When this Character declares a CHARGE ATTACK, it may lose 1 VITALITY to give its weapon +3 Velocity for that attack. This loss cannot be reduced by RESILIENCE.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
