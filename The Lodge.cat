            <selectionEntry id="2e7b-9f84-b7c8-d1ed" name="Agares’ Hawk" type="upgrade" hidden="false">
              <profiles>
                <profile id="3b7d-1729-0680-2a84" name="Agares’ Hawk" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="91" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Dread Diplomacy bargain</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, during this Character’s activation, all other UNENGAGED Friendly and Enemy Characters within 13” and Line of Sight must make a POWER TEST (1). If a Friendly Character fails, they must make free MOVE ACTION towards this Character. If an Enemy Character fails, they must make a free MOVE ACTION directly away from this Character.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="e9c8-3486-f65a-ecfe" name="Allocer’s Lance" type="upgrade" hidden="false">
              <profiles>
                <profile id="dd51-5d4e-a7e3-fdf5" name="Allocer’s Lance" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="91" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Dread Diplomacy bargain</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This Character gains +4 MIGHT when making a CHARGE ATTACK.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="b0f4-eef8-f5a9-91d7" name="Astaroth’s Viper" type="upgrade" hidden="false">
              <profiles>
                <profile id="375e-dc41-8df6-c77e" name="Astaroth’s Viper" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="91" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Dread Diplomacy bargain</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, during this Character’s activation, choose an UNENGAGED Enemy Character within 13” and Line of Sight to make an OPPOSED POWER TEST. If they fail, they must take the COWER reaction immediately (if possible).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="0707-dc51-154c-206f" name="Bune’s Heads" type="upgrade" hidden="false">
              <profiles>
                <profile id="8a28-1c28-ceb5-5ebb" name="Bune’s Heads" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="91" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Dread Diplomacy bargain</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, during this Character’s activation, another Friendly Character within 13” and Line of Sight of this Character may immediately remove up to 3 STRESS as a FREE ACTION.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="965d-912c-7fb2-1aa4" name="Bathin’s Horse" type="upgrade" hidden="false">
              <profiles>
                <profile id="e42c-8ee2-6cd8-654a" name="Bathin’s Horse" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="91" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Dread Diplomacy bargain</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, during this Character’s activation, an UNENGAGED Friendly Character (including this one) within 13” and Line of Sight may immediately be placed within 6” of their original position.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
