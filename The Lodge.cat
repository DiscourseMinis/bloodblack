        <profile id="1794-a8cf-e20a-fdcd" name="The Serpent’s Shadow" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="86" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Enemy Characters that start their turn ENGAGED with this Character gain 1 STRESS.</characteristic>
          </characteristics>
        </profile>
        <profile id="7a23-55bd-fe1f-2d2e" name="From Outside" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="86" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Does not suffer STRESS or take Activation Tests and cannot capture Places of Power. This character can only take Assets and Weapons with the LILITH’S GIFT trait. Does not add an Activation Token to the Chaos Bag. When this character is killed, do not remove an Activation Token from the Chaos Bag. If it has an assigned Activation Token, set that token aside until the next Reset Phase, then return it to the Chaos Bag.</characteristic>
          </characteristics>
        </profile>
        <profile id="fc39-eaf4-15e5-19f1" name="Savage Assault" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="86" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
            <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
            <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Innate. Melee</characteristic>
            <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Innate: Can never be disarmed.
Momentum: CHARGE attacks gain + [MORTAL] Potency.</characteristic>
          </characteristics>
        </profile>
      </profiles>
