                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="a78c-629b-2264-f10e" name="Abyssal Rod" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
              <costs>
