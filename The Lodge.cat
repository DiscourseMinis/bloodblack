              </constraints>
              <profiles>
                <profile id="125a-3b6b-f553-3ee5" name="Apple of Eden" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, after this character fails its first Cast Black Diablerie test of the turn and gains the normal STRESS from casting, it may immediately end its activation and return its Activation Token to the Chaos Bag. It becomes eligible to activate again this turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="7e96-3a43-5769-23a4" name="Doppelganger’s Finger" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
