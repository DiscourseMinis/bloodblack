    <selectionEntry id="a3d7-0259-78dc-dd1e" name="Living Shadow" type="model" hidden="false" page="87" publicationId="a21c-395e-03ec-6dcd">
      <categoryLinks>
        <categoryLink id="4c7f-bb26-ffc3-e03c" name="Characters" targetId="7818-f63f-5020-81d1" primary="true" hidden="false" />
      </categoryLinks>
      <costs>
        <cost name="Influence" typeId="f178-88bc-7258-0c88" value="70" />
      </costs>
      <profiles>
        <profile id="c701-6838-23f0-e41b" name="Living Shadow" typeId="7379-d42a-a99d-2084" typeName="Character (base profile)" publicationId="a21c-395e-03ec-6dcd" page="87" hidden="false">
          <characteristics>
            <characteristic name="Speed" typeId="5c3c-1745-c6f4-e1ab">6</characteristic>
            <characteristic name="Might" typeId="6c6c-02be-13ea-abc0">3</characteristic>
            <characteristic name="Finesse" typeId="ac91-114f-a56f-ac40">2</characteristic>
            <characteristic name="Power" typeId="58ce-692d-f1ed-f0d2">0</characteristic>
            <characteristic name="Reflex" typeId="285f-f125-f518-8cd9">2</characteristic>
            <characteristic name="Resilience" typeId="fc73-5c60-9144-ba15">2</characteristic>
            <characteristic name="Vitality" typeId="aa79-6e65-6e8c-b0da">9</characteristic>
            <characteristic name="Traits" typeId="9100-254c-435d-4a59">Devil.</characteristic>
            <characteristic name="Innate weapons" typeId="5f99-0e22-522c-59bc">Shadow Coils</characteristic>
          </characteristics>
        </profile>
        <profile id="40d8-0e98-89e8-1ee2" name="Dark Reflection" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="87" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">This Character can start the game ATTACHED to a friendly WITCH. During a game, it can ATTACH or UNATTACH to a friendly WITCH in base contact with this Character as a FREE ACTION. While attached, this character remains in base contact with its host and automatically moves with it for free whenever the host moves, regardless of distance. The host adds this character’s RESILIENCE to its own. This character remains a separate character and may be targeted normally. It may UNATTACH by moving away during its own activation. If the host is killed, this character remains in its current position and becomes UNATTACHED. A character can have only one Living Shadow attached to it at a time.</characteristic>
          </characteristics>
        </profile>
        <profile id="6772-1855-3fd0-e101" name="Shadow Walk" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="87" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">As printed (eye icon)</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">This Character can move through terrain and other characters, but cannot end any movement overlapping another character or inside solid terrain.</characteristic>
          </characteristics>
        </profile>
        <profile id="c260-26a8-5165-b068" name="From Outside" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="87" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Does not suffer STRESS or take Activation Tests and cannot capture Places of Power. This character can only take Assets and Weapons with the LILITH’S GIFT trait. Does not add an Activation Token to the Chaos Bag. When this character is killed, do not remove an Activation Token from the Chaos Bag. If it has an assigned Activation Token, set that token aside until the next Reset Phase, then return it to the Chaos Bag.</characteristic>
          </characteristics>
        </profile>
        <profile id="e821-c82c-5f43-8a06" name="Shadow Coils" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="87" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+2</characteristic>
            <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">STUN + TRANSCENDENT</characteristic>
            <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Innate. Melee</characteristic>
            <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Night Terror: This weapon loses all Potency while this Character is illuminated.
Innate: Can never be disarmed.</characteristic>
          </characteristics>
        </profile>
      </profiles>
