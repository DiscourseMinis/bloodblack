              </costs>
              <constraints>
                <constraint id="b90c-a6cd-2b38-98fb" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="fa3b-17a4-3ee0-d054" name="Abyssal Rod" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Enemy Characters within 8″ of this Character suffer −1 die on tests made to perform or resolve ACTIONS. Enemy COGs within 8″ of this character instead suffer −1 ATTACK when attacking.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
