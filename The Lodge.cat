                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Sever the Soul: Every 3rd successful Strike gains 1 [TRANSCENDENT] Potency damage.</characteristic>
                  </characteristics>
                </profile>
