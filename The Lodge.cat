            <selectionEntry id="280d-9806-6999-bd42" name="Animal Mask" type="upgrade" hidden="false" page="96" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="5" />
              </costs>
              <constraints>
                <constraint id="8ca6-5d79-33bb-9793" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="709c-aa9f-a96a-2135" name="Animal Mask" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="96" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per activation, when this Character assembles a POWER TEST, another friendly MORTAL within 8” may lose 1 VITALITY. This loss cannot be reduced by RESILIENCE. Add +1 die to this Character’s test.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
