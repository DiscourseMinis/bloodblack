                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+2</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Firearm. Ranged.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Reliable: When making an attack with this weapon, you may reroll each failed attack die once. Dice rerolled in this way cannot be rerolled again.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="3b03-20b5-78bd-030b" name="Ensorcelled Firearm" type="upgrade" hidden="false" page="89" publicationId="a21c-395e-03ec-6dcd">
