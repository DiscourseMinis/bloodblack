                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">TRANSCENDENT</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Sup Well: When this weapon deals the killing blow, it permanelty gains + [TRANSCENDENT] Potency.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="0acd-44b4-bf8b-c803" name="Reverse-Path Rifle" type="upgrade" hidden="false" page="89" publicationId="a21c-395e-03ec-6dcd">
              <costs>
