        <profile id="b102-7678-8f3a-9692" name="Root &amp; Branch" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="83" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Free</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Once per activation, if this character is ENGAGED, choose another friendly MORTAL within 8". If the chosen MORTAL is ENGAGED with the same Enemy Character as this Character, that MORTAL may immediately make a free MELEE ATTACK against that Enemy Character. If the chosen MORTAL is not ENGAGED, it may immediately perform a free SPRINT ACTION towards that Enemy Character and make a CHARGE ATTACK.</characteristic>
          </characteristics>
        </profile>
        <profile id="dd16-805d-5c3b-ff4b" name="Fellowship" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="83" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Other friendly MORTAL Characters within 8” gain +1 die to Activation Tests. A character can benefit from only one instance of this ability at a time.</characteristic>
          </characteristics>
        </profile>
        <profile id="a07e-f4cf-07f7-5902" name="Ascension" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="83" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">When this Character is killed, immediately choose a friendly WITCH within 8". That WITCH removes all VITALITY.</characteristic>
          </characteristics>
        </profile>
        <profile id="6c74-0d71-0c2f-44b3" name="Outside the Circle" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="83" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">This Character cannot equip weapons or assets with the Forbidden trait.</characteristic>
          </characteristics>
        </profile>
        <profile id="09d3-1d54-18a0-2555" name="Fists" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="83" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
            <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
            <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Innate. Melee</characteristic>
            <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Innate: Can never be disarmed.</characteristic>
          </characteristics>
        </profile>
      </profiles>
