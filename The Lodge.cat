                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="15" />
              </costs>
              <constraints>
                <constraint id="953c-9a83-963a-2971" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="dff4-4212-5e0e-e47c" name="Grave Wax Candle" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When assembling a POWER test to cast Blasphemous Sorcery or Black Diablerie, this character may light the candle. If it does, it counts as Illuminated until the end of the turn and adds +1 die to the test. If casting through Magician, it does not gain the Stress normally caused by that ability.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="bad1-700e-8bd4-fea5" name="Black Mirror" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="15" />
              </costs>
              <constraints>
                <constraint id="3d6d-52bb-3f24-e30e" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="f7be-51a5-33ca-dd87" name="Black Mirror" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">At the start of this character’s activation, it may teleport up to 12″ as a FREE ACTION, without requiring Line of Sight. Place it in a legal position. At the end of that activation, return it to its starting position. If that position is occupied or otherwise illegal, place it as close as possible in a legal position. Both teleports may take this character into or out of ENGAGEMENT, but do not generate CHARGE attacks or free attacks for DISENGAGING.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="a76c-d411-5559-61fc" name="Willow Pendant" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="15" />
              </costs>
              <constraints>
                <constraint id="1760-39a2-ade3-04d1" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="1e95-34f1-099d-5d36" name="Willow Pendant" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">While this Character occupies a Place of Power, it gains +2 POWER.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
