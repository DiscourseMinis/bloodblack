                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When this Character declares a CHARGE ATTACK, it may lose 1 VITALITY to give its weapon +3 Velocity for that attack. This loss cannot be reduced by RESILIENCE.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="383e-e5fb-4d80-04ce" name="Ascension Vest" type="upgrade" hidden="false" page="97" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="12" />
              </costs>
              <constraints>
                <constraint id="f5e8-89e3-cecf-12d8" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="84d2-3f6b-2c4f-b4ba" name="Ascension Vest" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="97" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Mortal only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per game, during their activation, this Character may choose to Ascend as a SIMPLE ACTION. If they do, each other Character within 2″ makes a REFLEX TEST. Each suffers 5 [MORTAL] damage, reduced by 1 for each success on its own test, to a minimum of 0. Apply RESILIENCE to the remaining damage as normal. After resolving the damage against all affected Characters, the wearer is killed.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup id="d318-2ce3-aa73-6c70" name="Unique assets" hidden="false">
          <constraints>
            <constraint id="9977-00f8-9dc6-3574" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
          </constraints>
          <entryLinks>
            <entryLink id="71d6-2508-d690-78cb" name="The Attendance Book" type="selectionEntry" targetId="0232-4148-08d8-97a7" hidden="false" />
          </entryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry id="bf56-8521-e8eb-1444" name="Worm" type="model" hidden="false" page="84" publicationId="a21c-395e-03ec-6dcd">
      <categoryLinks>
        <categoryLink id="f6f8-0fb7-3113-0b77" name="Characters" targetId="7818-f63f-5020-81d1" primary="true" hidden="false" />
      </categoryLinks>
      <costs>
        <cost name="Influence" typeId="f178-88bc-7258-0c88" value="50" />
      </costs>
      <profiles>
        <profile id="44d4-8686-dc1c-5c74" name="Worm" typeId="7379-d42a-a99d-2084" typeName="Character (base profile)" publicationId="a21c-395e-03ec-6dcd" page="84" hidden="false">
          <characteristics>
            <characteristic name="Speed" typeId="5c3c-1745-c6f4-e1ab">6</characteristic>
            <characteristic name="Might" typeId="6c6c-02be-13ea-abc0">2</characteristic>
            <characteristic name="Finesse" typeId="ac91-114f-a56f-ac40">2</characteristic>
            <characteristic name="Power" typeId="58ce-692d-f1ed-f0d2">2</characteristic>
            <characteristic name="Reflex" typeId="285f-f125-f518-8cd9">2</characteristic>
            <characteristic name="Resilience" typeId="fc73-5c60-9144-ba15">0</characteristic>
            <characteristic name="Vitality" typeId="aa79-6e65-6e8c-b0da">8</characteristic>
            <characteristic name="Traits" typeId="9100-254c-435d-4a59">Mortal.</characteristic>
            <characteristic name="Innate weapons" typeId="5f99-0e22-522c-59bc">Fists</characteristic>
          </characteristics>
        </profile>
        <profile id="220c-8ed0-5c17-727b" name="Local Resident" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="84" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">After normal deployment, this Character may deploy up to 12″ outside its Deployment Zone, but not inside enemy Deployment Zones or within 8″ of Enemy Characters.</characteristic>
          </characteristics>
        </profile>
        <profile id="0473-f694-e38a-60eb" name="Blood for Blood" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="84" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">When this Character is killed, before resolving any normal Activation Token removal, you may draw a Token at random from the Chaos Bag. If it is a Diablerie Token, resolve the corresponding Black Diablerie as though the token had been drawn normally. Otherwise, return the drawn token to the Chaos Bag. Then resolve any normal Activation Token removal.</characteristic>
          </characteristics>
        </profile>
        <profile id="50da-5c27-3707-0ca5" name="Outside the Circle" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="84" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">This Character cannot equip weapons or assets with the Forbidden trait.</characteristic>
          </characteristics>
        </profile>
        <profile id="199e-7556-60d1-d4e4" name="Fists" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="84" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
            <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
            <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Innate. Melee</characteristic>
            <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Innate: Can never be disarmed.</characteristic>
          </characteristics>
        </profile>
      </profiles>
