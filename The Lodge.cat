                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
              </costs>
              <profiles>
                <profile id="14cf-ff17-dda6-376c" name="Ghost Box" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">STUN</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Ranged: 8”.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Unearthly Frequency: When making an attack with this weapon, if your attack roll contains two or more dice showing the same result, you may change its Potency to [TRANSCENDENT].
Ineffable Tool: You must use your Power stat in place of Might/Finesse when making a melee/ranged attack with this weapon.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
