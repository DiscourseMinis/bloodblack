              <constraints>
                <constraint id="5334-0b4f-1f80-44e4" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="88b3-29f9-95a0-d526" name="Animal Mask" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="96" publicationId="a21c-395e-03ec-6dcd">
