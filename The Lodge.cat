      </costs>
      <constraints>
        <constraint id="dbfe-2b81-43a5-1866" type="max" value="1" field="selections" scope="force" shared="true" includeChildSelections="false" includeChildForces="false" percentValue="false" />
      </constraints>
      <profiles>
        <profile id="d022-fe48-9b49-8058" name="The Founder’s Revolver" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="96" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
            <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL + MORTAL</characteristic>
            <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Forbidden. Unique. Ranged: 12”.</characteristic>
            <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Final Revelation: Before assembling an attack pool, another friendly MORTAL within 3” may lose 1 VITALITY to let the wielder use POWER instead of FINESSE for this attack.
Compact: While engaged, this character may make Ranged Attacks with this weapon, but only against enemy characters they are ENGAGED with.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
