                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Gain +1 REFLEX per STRESS on this character (to a maximum of +4).</characteristic>
                  </characteristics>
