                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="5" />
              </costs>
              <constraints>
                <constraint id="3362-fb48-2444-d282" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="1786-0d38-2f35-d1d9" name="Animal Mask" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="96" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per activation, when this Character assembles a POWER TEST, another friendly MORTAL within 8” may lose 1 VITALITY. This loss cannot be reduced by RESILIENCE. Add +1 die to this Character’s test.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="9306-ec7e-1720-9c9f" name="Absolute Conviction" type="upgrade" hidden="false" page="97" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="8" />
              </costs>
              <constraints>
                <constraint id="3444-9f88-e48e-0ce5" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="8f08-a826-0524-6d8c" name="Absolute Conviction" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="97" publicationId="a21c-395e-03ec-6dcd">
