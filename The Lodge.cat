                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+1</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Sacrificial: Before attacking, a friendly MORTAL (including this one) within 3” of the target may lose 1 Vitality to grant +2 Velocity to the attack.
Commanding: If the Target of this attack is SURROUNDED! This weapon gains + [MORTAL] POTENCY.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="63a9-cab5-7990-78c5" name="Black Quartz Shotgun" type="upgrade" hidden="false" page="96" publicationId="a21c-395e-03ec-6dcd">
