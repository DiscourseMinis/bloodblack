              </constraints>
              <profiles>
                <profile id="4bdb-cee5-6592-0d0f" name="Infernal Stiching" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="98" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, before a friendly DEVIL within 8″ rolls a MELEE ATTACK, this Character may gain 1 STRESS to let that DEVIL reroll up to two failed attack dice. Each die may only be rerolled once.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="6459-1650-4eac-e46e" name="Number of the Beast" type="upgrade" hidden="false" page="99" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="18" />
              </costs>
              <constraints>
                <constraint id="29e8-57f3-b72c-fe5a" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="c24b-e106-74d9-a08a" name="Number of the Beast" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="99" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">After this Character makes its initial roll for a test, choose up to three dice showing a natural 6. For each die chosen, remove 1 STRESS from another Character within 13″ of this Character and change that die to a Critical Success. These Critical Successes explode as normal. This ability cannot be used on a Chance Die.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
