                <profile id="7c54-5c59-c0a2-3eb8" name="Uzi" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+2</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Firearm. Ranged.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Hip Fire: +2 Velocity when firing at a target within 4″, but suffers −2 Velocity when firing at a target more than 8″ away.
Compact: While ENGAGED, this Character may make RANGED ATTACKS with this weapon, but only against Enemy Characters they are ENGAGED with.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="5612-4369-0259-a25c" name="Soul Stealer" type="upgrade" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="20" />
              </costs>
