<?xml version='1.0' encoding='utf-8'?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="66fa-5ead-b881-29ba" name="The Damned" revision="3" battleScribeVersion="2.03" gameSystemId="1029-fba5-6af2-96d8" gameSystemRevision="3" library="false">
  <selectionEntries>
    <selectionEntry id="fea1-b729-fb6f-8369" name="Hierophant" type="model" hidden="false" page="80" publicationId="a21c-395e-03ec-6dcd">
      <categoryLinks>
        <categoryLink id="2d02-6d4e-4f47-8619" name="Characters" targetId="7818-f63f-5020-81d1" primary="true" hidden="false" />
      </categoryLinks>
      <costs>
        <cost name="Influence" typeId="f178-88bc-7258-0c88" value="105" />
      </costs>
      <constraints>
        <constraint id="f9f8-9cb7-6d15-ed6b" type="max" value="1" field="selections" scope="force" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
        <constraint id="4407-d243-1fef-1fda" type="min" value="1" field="selections" scope="force" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
      </constraints>
      <rules>
        <rule id="806c-786b-bbcd-e012" name="The Damned" hidden="false">
          <description>- May include THE DAMNED Characters and Assets, and perform the WALPURGIS BANE Black Diablerie. - Once per turn, after resolving all COG activations triggered by a PROGRAM Activation Token, you may assign that token to a friendly DEVIL character eligible to activate. That DEVIL immediately takes a full activation, following the normal activation rules.</description>
        </rule>
      </rules>
      <profiles>
        <profile id="be07-b357-63a4-076c" name="Hierophant" typeId="7379-d42a-a99d-2084" typeName="Character (base profile)" publicationId="a21c-395e-03ec-6dcd" page="80" hidden="false">
          <characteristics>
            <characteristic name="Speed" typeId="5c3c-1745-c6f4-e1ab">6</characteristic>
            <characteristic name="Might" typeId="6c6c-02be-13ea-abc0">3</characteristic>
            <characteristic name="Finesse" typeId="ac91-114f-a56f-ac40">3</characteristic>
            <characteristic name="Power" typeId="58ce-692d-f1ed-f0d2">7</characteristic>
            <characteristic name="Reflex" typeId="285f-f125-f518-8cd9">2</characteristic>
            <characteristic name="Resilience" typeId="fc73-5c60-9144-ba15">0</characteristic>
            <characteristic name="Vitality" typeId="aa79-6e65-6e8c-b0da">9</characteristic>
            <characteristic name="Traits" typeId="9100-254c-435d-4a59">Witch. Unique.</characteristic>
            <characteristic name="Innate weapons" typeId="5f99-0e22-522c-59bc">Fists</characteristic>
          </characteristics>
        </profile>
        <profile id="a337-e96f-e8a3-b0c3" name="The First To Disobey" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="80" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Complex</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">If this Character is within 3” of a Place of Power and is not ENGAGED, it may take a COMPLEX ACTION to cast a BLACK DIABLERIE, following the rules of BLACK DIABLERIE on Page 100.</characteristic>
          </characteristics>
        </profile>
        <profile id="3386-5eb3-256d-a1fc" name="The Shade That Trees Spit Out" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="80" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Simple</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">If this character is not Engaged with an enemy character, it may take a Simple Action to cast a spell from the Blasphemous Sorcery list. After resolving the casting attempt and any spell effects, this character gains 1 STRESS, whether the spell succeeded or failed.</characteristic>
          </characteristics>
        </profile>
        <profile id="279f-ea7e-0aa8-6bd5" name="The Devil Has Spoken, Doubt Is Sacrilege" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="80" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Simple</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">If this character is not ENGAGED with an enemy character, it may take a SIMPLE ACTION to cast a spell from the Blasphemous Sorcery list. After resolving the casting attempt and any spell effects, this character gains 1 STRESS, whether the spell succeeded or failed.</characteristic>
          </characteristics>
        </profile>
        <profile id="852c-55a3-5f9b-4409" name="Magician" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="80" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Simple</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">If this character is not ENGAGED, it may take a SIMPLE ACTION to cast a spell from the Blasphemous Sorcery list on Page 102. After resolving the casting attempt and any spell effects, this character gains 1 STRESS, whether the spell succeeded or failed.</characteristic>
          </characteristics>
        </profile>
        <profile id="c11a-246e-b458-8afb" name="Fists" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="80" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
            <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
            <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Innate. Melee</characteristic>
            <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Innate: Can never be disarmed.</characteristic>
          </characteristics>
        </profile>
        <profile id="8f5f-d538-82c5-5e16" name="Blasphemous Sorcery" typeId="653c-9eec-114f-7b3e" typeName="Casting" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Procedure" typeId="a469-c2c4-8dee-eacd">To CAST a Blasphemous Sorcery, the CASTER must choose the SPELL they want to CAST and any target. Then take a POWER TEST and meet the THRESHOLD. If they succeed, resolve the effects of the SPELL. If they fail, nothing happens. SPELLS are ALWAYS resisted, even if cast on a friendly Character.</characteristic>
          </characteristics>
        </profile>
        <profile id="66b1-75ef-b743-4e06" name="Otherworldly Pact" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">1</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">12”</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Choose a Character within range and Line of Sight. The Target loses 1 VITALITY. Then it gains +1 die on its next roll for each success scored on the casting test, to a maximum of +3 dice. A character can have only one unused Otherworldly Pact bonus at a time; a new bonus replaces the previous one rather than stacking.</characteristic>
          </characteristics>
        </profile>
        <profile id="fa08-8fbc-5c77-e55c" name="Glimpse The Code" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">1</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">~</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Look at the top card of the DREAD DECK, you may then place it at the top or bottom of the deck.</characteristic>
          </characteristics>
        </profile>
        <profile id="2fbf-a6d2-357d-1982" name="Dead Man’s Steps" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">2</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">12”</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Choose a point within range and Line of Sight of the caster. Every unengaged COG within 12″ of that point that cannot currently detect an eligible Player Character immediately moves up to its Speed towards it, stopping upon reaching it. This movement cannot generate attacks or free CHARGE attacks. Each COG can only be moved by this spell once per turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="3f8a-b8aa-ca69-d039" name="World Without Doors" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">1</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">Self</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Move the casting Character to anywhere within 18” and line-of-sight.</characteristic>
          </characteristics>
        </profile>
        <profile id="a8ad-c43e-0314-5641" name="Calcify" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">Opposed</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">12”</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Choose a Character within range and Line of Sight. If successful, the target gains +4 RESILIENCE but cannot take any actions until the end of the turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="5e70-3a78-7b48-1f79" name="Wither" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">Opposed</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">12”</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Choose an Enemy Character within range and Line of Sight. If successful, the Target suffers 1 STRESS, plus 1 additional STRESS for each unblocked success.</characteristic>
          </characteristics>
        </profile>
        <profile id="fa38-2b3e-834a-e9da" name="Phantom Razor" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">Opposed</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">12”</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Choose an Enemy Character within range and Line of Sight. If successful, the target suffers 1 STRESS, then suffers [TRANSCENDENT] DAMAGE equal to its current STRESS. Then remove all STRESS from the target.</characteristic>
          </characteristics>
        </profile>
        <profile id="b121-4b39-4dd7-5f89" name="Witchfire" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">Opposed</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">8”</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Choose an Enemy Character within range and Line of Sight. If successful, inflict [FIRE] DAMAGE on the target per unblocked success. This spell does not illuminate the caster.</characteristic>
          </characteristics>
        </profile>
        <profile id="32c1-6d22-77de-c18b" name="Black Diablerie" typeId="653c-9eec-114f-7b3e" typeName="Casting" hidden="false" page="100" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Procedure" typeId="a469-c2c4-8dee-eacd">To CAST a Black Diablerie, the CASTER must choose the BLACK DIABLERIE they want to CAST and then suffer 1 STRESS. Then take a POWER TEST and meet the THRESHOLD. If they FAIL, nothing happens. If they SUCCEED, add one DIABLERIE TOKEN to the Chaos Bag. The Caster is now CASTING. Record the caster and the chosen ritual. Any additional Diablerie Tokens generated by abilities or assets belong to the same caster and ritual. When a DIABLERIE TOKEN is drawn from the Chaos Bag, resolve the chosen BLACK DIABLERIE’S effect immediately, making any required choices and selecting targets at this point unless the ritual states otherwise. Remove any remaining Diablerie Tokens belonging to that ritual from the Chaos Bag. The caster ceases Casting, and the Coven cannot attempt another BLACK DIABLERIE this turn. If the Caster is KILLED while CASTING, the ritual fails. Immediately remove all its DIABLERIE TOKENS from the Chaos Bag. The caster ceases CASTING, and the ritual has no effect.</characteristic>
          </characteristics>
        </profile>
        <profile id="189d-3b04-9ff5-97d2" name="Walpurgis Bane" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="100" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">3</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">Add one additional PROGRAM Activation Token to the Chaos Bag. It follows all normal PROGRAM Activation Token rules. Remove one PROGRAM Activation Token from play during this turn’s Reset Phase. For this turn, you may use the Damned faction ability to activate a friendly DEVIL twice in total, once per PROGRAM Activation Token drawn.</characteristic>
          </characteristics>
        </profile>
        <profile id="36ca-bbcd-37ca-e985" name="Rite of the Coiling Dragon" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="100" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">2</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">Friendly Characters without an Activation Token assigned count as if they took COWER reactions when they are attacked this turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="f2f6-23b2-9755-1c8f" name="We Who Work For Principalities And Dark Places" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="100" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">2</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">Friendly MORTAL Characters gain 1 STRESS. Friendly DEVIL Characters recover 3 VITALITY.</characteristic>
          </characteristics>
        </profile>
        <profile id="f5c3-0ea0-1092-1084" name="Deception From A Serpent’s Mind" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="100" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">2</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">Choose an Enemy Character within range and Line of Sight. If successful, the Target suffers 1 STRESS, plus 1 additional STRESS for each unblocked success.</characteristic>
          </characteristics>
        </profile>
        <profile id="c63a-d91c-6bea-646a" name="The Light Of Dead Angels" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="100" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">2</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">Choose a Character. For the rest of the game, that Character ignores the Night rule when making attacks. This effect does not make the character Illuminated.</characteristic>
          </characteristics>
        </profile>
        <profile id="96f2-4fce-bd34-5f70" name="The Mindless Flutes Of An Idiot God" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="101" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">2</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">Choose up to 2 Activation Tokens already assigned to Characters and return them to the Chaos Bag. Each affected Character becomes eligible to activate again this turn, and any ongoing COWER or VIGIL benefits associated with its returned token end. No further spell can be cast by the Coven player this turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="deca-e48c-0d1f-9a02" name="Asmoday’s Gift" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="101" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">2</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">All friendly DEVIL Characters with Activation Tokens assigned to them (including PROGRAM Activation Tokens) can make a single SIMPLE ACTION.</characteristic>
          </characteristics>
        </profile>
        <profile id="1069-3fbf-46dd-a70a" name="Weigh The Soul" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="101" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">2</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">Remove a random Activation Token from the Chaos Bag. The Coven player then decides if it is returned to the Chaos bag, or set aside out of play until the end of the RESET PHASE.</characteristic>
          </characteristics>
        </profile>
        <profile id="993e-e312-9494-12de" name="Grasp The Left Hand" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="101" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">3</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">Reveal the next Activation Token drawn from the Chaos Bag and resolve it as follows:
- Enemy crew token: You may assign the token to an eligible Character from that crew and control it for this activation. Resolve its activation normally, including any required Activation Test. Until the activation ends, it treats your crew as friendly and the other Characters in its own crew as enemies.
- PROGRAM token: Choose one eligible COG. When it activates, you control it for that activation. It may perform two actions, each either a Move or an Attack, in any order. You choose its movement and legal targets, using its normal profile and attack rules. All other eligible COGs activate normally.</characteristic>
          </characteristics>
        </profile>
        <profile id="77e7-43cc-1afd-751b" name="Both Beast And Angel" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="101" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">3</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">All Friendly MORTAL and WITCH Characters permanently gain +1 FINESSE.</characteristic>
          </characteristics>
        </profile>
        <profile id="a9d0-7ab0-28d9-b27a" name="The Most Blasphemous Curse" typeId="2ba6-8908-b4c0-abe2" typeName="Black Diablerie" hidden="false" page="101" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="00c8-01c0-2df4-3a69">4</characteristic>
            <characteristic name="Effect" typeId="a361-effd-c842-7dc4">Reverse the status of every Place of Power on the battlefield: ACTIVE Places become INERT, and INERT Places become ACTIVE. Every Character occupying a Place of Power immediately gains 2 STRESS and is PUSHED 3" directly away from it.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntryGroups>
        <selectionEntryGroup id="e021-e242-8719-1716" name="Weapons" hidden="false">
          <selectionEntries>
            <selectionEntry id="0df5-4cfd-d3a3-5e74" name="Club" type="upgrade" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="5" />
              </costs>
              <profiles>
                <profile id="f41e-0d7e-7078-124d" name="Club" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">—</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="e04f-ba5d-fc00-0728" name="Ghost Box" type="upgrade" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
              </costs>
              <profiles>
                <profile id="cf29-0edf-1cd2-3f20" name="Ghost Box" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">STUN</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Ranged: 8”.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Unearthly Frequency: When making an attack with this weapon, if your attack roll contains two or more dice showing the same result, you may change its Potency to [TRANSCENDENT].
Ineffable Tool: You must use your Power stat in place of Might/Finesse when making a melee/ranged attack with this weapon.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="922a-ea34-a068-1abd" name="Gleaming Athame" type="upgrade" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="17" />
              </costs>
              <profiles>
                <profile id="4e6d-9182-f999-d663" name="Gleaming Athame" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+4</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Sever the Soul: Every 3rd successful Strike gains 1 [TRANSCENDENT] Potency damage.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="1d4a-e2c1-d310-5f65" name="Uzi" type="upgrade" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
              <costs>
