    </selectionEntry>
    <selectionEntry id="21dd-a91a-03d6-d220" name="Faceless Sister" type="model" hidden="false" page="82" publicationId="a21c-395e-03ec-6dcd">
      <categoryLinks>
        <categoryLink id="a8a4-14ee-9f13-b965" name="Characters" targetId="7818-f63f-5020-81d1" primary="true" hidden="false" />
      </categoryLinks>
      <costs>
        <cost name="Influence" typeId="f178-88bc-7258-0c88" value="70" />
      </costs>
      <profiles>
        <profile id="b7d6-db29-af06-7c8c" name="Faceless Sister" typeId="7379-d42a-a99d-2084" typeName="Character (base profile)" publicationId="a21c-395e-03ec-6dcd" page="82" hidden="false">
          <characteristics>
            <characteristic name="Speed" typeId="5c3c-1745-c6f4-e1ab">6</characteristic>
            <characteristic name="Might" typeId="6c6c-02be-13ea-abc0">3</characteristic>
            <characteristic name="Finesse" typeId="ac91-114f-a56f-ac40">3</characteristic>
            <characteristic name="Power" typeId="58ce-692d-f1ed-f0d2">5</characteristic>
            <characteristic name="Reflex" typeId="285f-f125-f518-8cd9">2</characteristic>
            <characteristic name="Resilience" typeId="fc73-5c60-9144-ba15">0</characteristic>
            <characteristic name="Vitality" typeId="aa79-6e65-6e8c-b0da">8</characteristic>
            <characteristic name="Traits" typeId="9100-254c-435d-4a59">Witch.</characteristic>
            <characteristic name="Innate weapons" typeId="5f99-0e22-522c-59bc">Fists</characteristic>
          </characteristics>
        </profile>
        <profile id="3678-3e59-25d6-b034" name="Left Hand Path" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="82" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">When another friendly WITCH within 8" of this Character makes a POWER TEST, this character may add +1 die to that test. After resolving the test, this character gains 1 STRESS. A casting test can benefit from Left Hand Path only once; if several characters with this ability are eligible, choose one to provide the bonus and gain the STRESS.</characteristic>
          </characteristics>
        </profile>
        <profile id="b470-401d-40a3-30d7" name="Soulstone" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="82" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">When this character is killed before receiving an Activation Token, do not remove one of your crew’s Activation Tokens from the Chaos Bag as normal. Instead, remove one at the next Reset Phase.</characteristic>
          </characteristics>
        </profile>
        <profile id="d810-518a-7a67-c50b" name="Magician" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="82" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Simple</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">If this character is not ENGAGED, it may take a SIMPLE ACTION to cast a spell from the Blasphemous Sorcery list on Page 102. After resolving the casting attempt and any spell effects, this character gains 1 STRESS, whether the spell succeeded or failed.</characteristic>
          </characteristics>
        </profile>
        <profile id="47eb-8d1c-c13f-7b71" name="Fists" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="82" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
            <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
            <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Innate. Melee</characteristic>
            <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Innate: Can never be disarmed.</characteristic>
          </characteristics>
        </profile>
        <profile id="8eb5-79fc-69a0-65c2" name="Blasphemous Sorcery" typeId="653c-9eec-114f-7b3e" typeName="Casting" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Procedure" typeId="a469-c2c4-8dee-eacd">To CAST a Blasphemous Sorcery, the CASTER must choose the SPELL they want to CAST and any target. Then take a POWER TEST and meet the THRESHOLD. If they succeed, resolve the effects of the SPELL. If they fail, nothing happens. SPELLS are ALWAYS resisted, even if cast on a friendly Character.</characteristic>
          </characteristics>
        </profile>
        <profile id="2bec-55bb-3b10-c04e" name="Otherworldly Pact" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">1</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">12”</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Choose a Character within range and Line of Sight. The Target loses 1 VITALITY. Then it gains +1 die on its next roll for each success scored on the casting test, to a maximum of +3 dice. A character can have only one unused Otherworldly Pact bonus at a time; a new bonus replaces the previous one rather than stacking.</characteristic>
          </characteristics>
        </profile>
        <profile id="a214-1659-d301-3384" name="Glimpse The Code" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">1</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">~</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Look at the top card of the DREAD DECK, you may then place it at the top or bottom of the deck.</characteristic>
          </characteristics>
        </profile>
        <profile id="77fb-ea4e-fc88-f06e" name="Dead Man’s Steps" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">2</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">12”</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Choose a point within range and Line of Sight of the caster. Every unengaged COG within 12″ of that point that cannot currently detect an eligible Player Character immediately moves up to its Speed towards it, stopping upon reaching it. This movement cannot generate attacks or free CHARGE attacks. Each COG can only be moved by this spell once per turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="5257-a85b-9a0a-bd70" name="World Without Doors" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">1</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">Self</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Move the casting Character to anywhere within 18” and line-of-sight.</characteristic>
          </characteristics>
        </profile>
        <profile id="a87e-0060-f1fa-6f84" name="Calcify" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">Opposed</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">12”</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Choose a Character within range and Line of Sight. If successful, the target gains +4 RESILIENCE but cannot take any actions until the end of the turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="7e2b-91ac-8491-9bcc" name="Wither" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">Opposed</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">12”</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Choose an Enemy Character within range and Line of Sight. If successful, the Target suffers 1 STRESS, plus 1 additional STRESS for each unblocked success.</characteristic>
          </characteristics>
        </profile>
        <profile id="7fbf-ccff-3e2e-9fdf" name="Phantom Razor" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">Opposed</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">12”</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Choose an Enemy Character within range and Line of Sight. If successful, the target suffers 1 STRESS, then suffers [TRANSCENDENT] DAMAGE equal to its current STRESS. Then remove all STRESS from the target.</characteristic>
          </characteristics>
        </profile>
        <profile id="2044-d4eb-5af3-6a4b" name="Witchfire" typeId="c85f-01ec-ba55-3b91" typeName="Blasphemous Sorcery" hidden="false" page="102" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Threshold" typeId="e172-23db-b26b-51ce">Opposed</characteristic>
            <characteristic name="Range" typeId="ee39-dfda-ba89-4dc8">8”</characteristic>
            <characteristic name="Effect" typeId="c3ce-0155-240b-5da9">Choose an Enemy Character within range and Line of Sight. If successful, inflict [FIRE] DAMAGE on the target per unblocked success. This spell does not illuminate the caster.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntryGroups>
        <selectionEntryGroup id="3a80-98e4-61f9-ef79" name="Weapons" hidden="false">
          <selectionEntries>
            <selectionEntry id="166e-cedc-ca9c-127e" name="Club" type="upgrade" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="5" />
              </costs>
              <profiles>
                <profile id="c3a9-ab7b-4ff2-75ed" name="Club" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">—</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="4cb3-cea6-9e5e-6abb" name="Ghost Box" type="upgrade" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
              </costs>
              <profiles>
                <profile id="428a-6d97-c3bd-aab6" name="Ghost Box" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">STUN</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Ranged: 8”.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Unearthly Frequency: When making an attack with this weapon, if your attack roll contains two or more dice showing the same result, you may change its Potency to [TRANSCENDENT].
Ineffable Tool: You must use your Power stat in place of Might/Finesse when making a melee/ranged attack with this weapon.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="19ce-726f-1653-8435" name="Gleaming Athame" type="upgrade" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="17" />
              </costs>
              <profiles>
                <profile id="b02d-88d5-a4f5-4a5f" name="Gleaming Athame" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+4</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Sever the Soul: Every 3rd successful Strike gains 1 [TRANSCENDENT] Potency damage.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="9108-5eca-9e33-5016" name="Uzi" type="upgrade" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="18" />
              </costs>
              <profiles>
                <profile id="1930-afa0-87d1-fa52" name="Uzi" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+2</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Firearm. Ranged.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Hip Fire: +2 Velocity when firing at a target within 4″, but suffers −2 Velocity when firing at a target more than 8″ away.
Compact: While ENGAGED, this Character may make RANGED ATTACKS with this weapon, but only against Enemy Characters they are ENGAGED with.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="7634-6b64-1da4-704d" name="Soul Stealer" type="upgrade" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="20" />
              </costs>
              <profiles>
                <profile id="7972-fc60-cc56-f8e0" name="Soul Stealer" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+3</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">TRANSCENDENT</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Sup Well: When this weapon deals the killing blow, it permanelty gains + [TRANSCENDENT] Potency.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="f552-773a-ae07-17c9" name="Reverse-Path Rifle" type="upgrade" hidden="false" page="89" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="24" />
              </costs>
              <profiles>
                <profile id="1fe8-453a-d58f-d631" name="Reverse-Path Rifle" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="89" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+2</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">TRANSCENDENT</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Firearm. Ranged.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Mirrored Bullets: When firing at a target in cover, that target suffers −2 REFLEX instead of the usual +2 cover bonus. Against a COG in cover, apply −1 DEFENSE instead of the usual +1 DEFENSE bonus. When firing at a target without cover, that target gains +2 REFLEX, or +1 DEFENSE if it is a COG.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="7a9a-8fac-f6cd-85e0" name="Accursed Flute" type="upgrade" hidden="false" page="89" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="25" />
              </costs>
              <profiles>
                <profile id="5134-cab4-b089-5bd6" name="Accursed Flute" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="89" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+4</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">TRANSCENDENT + TRANSCENDENT</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Forbidden. Ranged.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Pulse 8”: Area attack centred on the attacker; radius 8”.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="5a89-9780-d610-5577" name="AK-47" type="upgrade" hidden="false" page="89" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="30" />
              </costs>
              <profiles>
                <profile id="132e-589a-eb93-4e50" name="AK-47" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="89" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+2</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Firearm. Ranged.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Reliable: When making an attack with this weapon, you may reroll each failed attack die once. Dice rerolled in this way cannot be rerolled again.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="9e4e-27b6-35db-2a5e" name="Ensorcelled Firearm" type="upgrade" hidden="false" page="89" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="35" />
              </costs>
              <profiles>
                <profile id="2c5e-1e2e-bb42-1934" name="Ensorcelled Firearm" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="89" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">TRANSCENDENT + TRANSCENDENT</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Firearm. Magical. Ranged.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Attuned: You may use your Power stat in place of Might/Finesse when making a melee/ranged attack with this weapon.
Destructive: After resolving REFLEX or DEFENSE, each unblocked Critical Success generates two Strikes instead of one.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="10a6-96d9-41b2-3464" name="Fork of the Accuser" type="upgrade" hidden="false" page="98" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="18" />
              </costs>
              <profiles>
                <profile id="aeed-dcdc-ed11-b44d" name="Fork of the Accuser" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="98" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+2</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">TRANSCENDENT</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Condemnation: This weapon gains + [TRANSCENDENT] Potency when attacking a target with 3 or more STRESS.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="2a92-8c5c-fcd4-d54c" name="Black Mass Bell" type="upgrade" hidden="false" page="98" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="20" />
              </costs>
              <profiles>
                <profile id="2367-afb2-c60b-204c" name="Black Mass Bell" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="98" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">STUN</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Forbidden. Ranged: 8”.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Attuned: You may use your Power stat in place of Might/Finesse when making a melee/ranged attack with this weapon.
Unholy Summons: After resolving an attack that inflicts at least one Strike, for each Strike, one friendly DEVIL within 6” of the wielder may move up to 2” towards the target. If this movement takes the DEVIL out of ENGAGEMENT, resolve a DISENGAGE TEST and any resulting enemy free MELEE ATTACKS as normal before moving. This movement cannot generate CHARGE ATTACKS.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
