                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Devil only. Lilith’s Gift.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When an Enemy Character begins its activation within 8” of one or more Characters with Incomprehensible Form, it gains 1 STRESS. A character can gain STRESS from Incomprehensible Form only once per activation, regardless of how many models with this ability are within range.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
