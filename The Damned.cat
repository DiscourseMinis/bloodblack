                <profile id="9d43-754c-cf3c-9db0" name="Soul Stealer" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="88" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+3</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">TRANSCENDENT</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Sup Well: When this weapon deals the killing blow, it permanelty gains + [TRANSCENDENT] Potency.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="2bb9-e254-153f-b2b3" name="Reverse-Path Rifle" type="upgrade" hidden="false" page="89" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="24" />
              </costs>
              <profiles>
                <profile id="2041-e6dc-f135-9a85" name="Reverse-Path Rifle" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="89" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+2</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">TRANSCENDENT</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Firearm. Ranged.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Mirrored Bullets: When firing at a target in cover, that target suffers −2 REFLEX instead of the usual +2 cover bonus. Against a COG in cover, apply −1 DEFENSE instead of the usual +1 DEFENSE bonus. When firing at a target without cover, that target gains +2 REFLEX, or +1 DEFENSE if it is a COG.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="4336-0bb3-97d3-cb33" name="Accursed Flute" type="upgrade" hidden="false" page="89" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="25" />
              </costs>
              <profiles>
                <profile id="14df-741a-6174-374c" name="Accursed Flute" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="89" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+4</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">TRANSCENDENT + TRANSCENDENT</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Forbidden. Ranged.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Pulse 8”: Area attack centred on the attacker; radius 8”.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="6074-636e-3046-31ec" name="AK-47" type="upgrade" hidden="false" page="89" publicationId="a21c-395e-03ec-6dcd">
