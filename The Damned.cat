      </categoryLinks>
      <costs>
        <cost name="Influence" typeId="f178-88bc-7258-0c88" value="50" />
      </costs>
      <profiles>
        <profile id="5ed1-e218-8585-7102" name="Worm" typeId="7379-d42a-a99d-2084" typeName="Character (base profile)" publicationId="a21c-395e-03ec-6dcd" page="84" hidden="false">
