              </constraints>
              <profiles>
                <profile id="a0cd-0cb5-4187-9069" name="Hearthstone Talisman" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="91" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This Character gains +3 VITALITY.</characteristic>
                  </characteristics>
                </profile>
