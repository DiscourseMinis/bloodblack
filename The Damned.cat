              </constraints>
              <profiles>
                <profile id="2342-b8c4-7239-6582" name="Haemonculus Fetish" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Gain +1 REFLEX per STRESS on this character (to a maximum of +4).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="94c6-fe48-43ab-fc59" name="Apple of Eden" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
              </costs>
              <constraints>
                <constraint id="caa4-f27e-b3e1-e24c" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="00e7-f5e4-5f34-cdbd" name="Apple of Eden" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, after this character fails its first Cast Black Diablerie test of the turn and gains the normal STRESS from casting, it may immediately end its activation and return its Activation Token to the Chaos Bag. It becomes eligible to activate again this turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="6394-8a5d-9dca-e9ed" name="Doppelganger’s Finger" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
              </costs>
              <constraints>
                <constraint id="f49d-707a-8f63-9fb4" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="0f02-47f6-4efd-65ef" name="Doppelganger’s Finger" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When you would add a Coven Diablerie Token to the Chaos Bag, add another for the same caster and chosen Black Diablerie. Both tokens belong to that single ritual.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="fb1b-2dda-b188-ebc4" name="Haunted Doll" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="12" />
              </costs>
              <constraints>
                <constraint id="8cd3-764b-d8db-8ab7" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="cafc-338c-72d6-9fc9" name="Haunted Doll" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">The first time you would gain STRESS each turn, you may choose not to.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="3378-bd36-eeff-bd23" name="Abyssal Rod" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="13" />
              </costs>
              <constraints>
                <constraint id="9a04-28d0-2e99-5608" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="f6f3-dcd9-d037-7693" name="Abyssal Rod" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Enemy Characters within 8″ of this Character suffer −1 die on tests made to perform or resolve ACTIONS. Enemy COGs within 8″ of this character instead suffer −1 ATTACK when attacking.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="472c-3693-62fe-2488" name="Bloody Broomstick" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="15" />
              </costs>
              <constraints>
                <constraint id="8cfe-099a-b730-c9d8" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="ca4b-9e6a-781b-0c72" name="Bloody Broomstick" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This character may move over or onto terrain and obstacles up to 6″ higher than its starting surface, ignoring vertical distance when measuring movement. When jumping, this character may jump up to its full Speed during a Move, or double its Speed during a Sprint.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="684d-ce59-f795-ca6c" name="Grave Wax Candle" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="15" />
              </costs>
              <constraints>
                <constraint id="492b-2547-80cd-69ae" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="f107-b055-89c4-eb92" name="Grave Wax Candle" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When assembling a POWER test to cast Blasphemous Sorcery or Black Diablerie, this character may light the candle. If it does, it counts as Illuminated until the end of the turn and adds +1 die to the test. If casting through Magician, it does not gain the Stress normally caused by that ability.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="c71b-0e18-a14d-a845" name="Black Mirror" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="15" />
              </costs>
              <constraints>
                <constraint id="1791-575d-4bc1-7a90" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="8dc2-fbbf-37a5-d7bb" name="Black Mirror" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">At the start of this character’s activation, it may teleport up to 12″ as a FREE ACTION, without requiring Line of Sight. Place it in a legal position. At the end of that activation, return it to its starting position. If that position is occupied or otherwise illegal, place it as close as possible in a legal position. Both teleports may take this character into or out of ENGAGEMENT, but do not generate CHARGE attacks or free attacks for DISENGAGING.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="f21e-8af1-9f6a-db89" name="Willow Pendant" type="upgrade" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="15" />
              </costs>
              <constraints>
                <constraint id="1979-b429-78f4-0090" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="4401-fdf6-8e89-3828" name="Willow Pendant" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="90" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">While this Character occupies a Place of Power, it gains +2 POWER.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="d00e-b536-d362-d632" name="Solomon’s Ring" type="upgrade" hidden="false" page="91" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="15" />
              </costs>
              <constraints>
                <constraint id="2ac8-1d57-a189-5458" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="9f14-06a7-7e64-c72d" name="Solomon’s Ring" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="91" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Witch only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When this character successfully activates, choose a friendly DEVIL character within 13”. That DEVIL may immediately perform one free SIMPLE ACTION.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
