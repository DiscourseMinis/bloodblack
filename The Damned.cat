        <cost name="Influence" typeId="f178-88bc-7258-0c88" value="135" />
      </costs>
      <constraints>
        <constraint id="32aa-bb8a-804f-2a6e" type="max" value="1" field="selections" scope="force" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
      </constraints>
      <profiles>
        <profile id="1988-fcb6-2fd7-b9c7" name="Archfiend" typeId="7379-d42a-a99d-2084" typeName="Character (base profile)" publicationId="a21c-395e-03ec-6dcd" page="85" hidden="false">
          <characteristics>
            <characteristic name="Speed" typeId="5c3c-1745-c6f4-e1ab">8</characteristic>
            <characteristic name="Might" typeId="6c6c-02be-13ea-abc0">6</characteristic>
            <characteristic name="Finesse" typeId="ac91-114f-a56f-ac40">6</characteristic>
            <characteristic name="Power" typeId="58ce-692d-f1ed-f0d2">0</characteristic>
            <characteristic name="Reflex" typeId="285f-f125-f518-8cd9">4</characteristic>
            <characteristic name="Resilience" typeId="fc73-5c60-9144-ba15">2</characteristic>
            <characteristic name="Vitality" typeId="aa79-6e65-6e8c-b0da">17</characteristic>
            <characteristic name="Traits" typeId="9100-254c-435d-4a59">Devil. Unique.</characteristic>
            <characteristic name="Innate weapons" typeId="5f99-0e22-522c-59bc">Flauros’ Claws</characteristic>
          </characteristics>
        </profile>
        <profile id="fd09-d209-6fcf-ff7d" name="Blood Sacrifice" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="85" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">This character does not deploy normally. Once per game, when a MORTAL is killed, you may immediately deploy this Character in the space it occupied. If its base cannot fit, place it as close as possible in a legal position.</characteristic>
          </characteristics>
        </profile>
        <profile id="918f-1e92-9943-5517" name="Supreme Evil" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="85" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">When your crew’s Diablerie Token is drawn, instead of resolving the Black Diablerie ritual, this character may CONSUME the Ritual. If they do: assign that Diablerie Token to this Character as if it were an Activation Token, the caster ceases Casting, remove all remaining tokens for that ritual from the Chaos Bag, and the crew cannot attempt another BLACK DIABLERIE this turn. If this character has CONSUMED a Ritual this game, it permanently gains:</characteristic>
          </characteristics>
        </profile>
        <profile id="988a-2c8d-4be7-85cd" name="Amdusias’ Cacophony" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="85" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Free</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Once per turn, all other Characters within 13” immediately suffer 1 STRESS.</characteristic>
          </characteristics>
        </profile>
        <profile id="e868-adb6-03cc-a1a3" name="Elite" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="85" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Each turn, this character may be assigned an Activation Token up to three times. Each Activation Token assigned grants a separate activation.</characteristic>
          </characteristics>
        </profile>
        <profile id="3a30-eadb-8f7d-dab3" name="From Outside" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="85" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Does not suffer STRESS or take Activation Tests and cannot capture Places of Power. This character can only take Assets and Weapons with the LILITH’S GIFT trait. Does not add an Activation Token to the Chaos Bag. When this character is killed, do not remove an Activation Token from the Chaos Bag. If it has an assigned Activation Token, set that token aside until the next Reset Phase, then return it to the Chaos Bag.</characteristic>
          </characteristics>
        </profile>
        <profile id="2684-5f87-fafd-afe6" name="Flauros’ Claws" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="85" publicationId="a21c-395e-03ec-6dcd">
          <characteristics>
            <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
            <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">TRANSCENDENT</characteristic>
            <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Innate. Melee</characteristic>
            <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Blasphemous Assault: This weapon gains +1 Velocity for each STRESS on the Target.
Innate: Can never be disarmed.</characteristic>
          </characteristics>
        </profile>
      </profiles>
