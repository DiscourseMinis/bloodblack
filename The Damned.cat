          <characteristics>
            <characteristic name="Action" typeId="f8c1-cda5-b6e1-42b7">Passive</characteristic>
            <characteristic name="Effect" typeId="cd99-8fcd-7fa2-bfed">Enemy Characters that start their turn ENGAGED with this Character gain 1 STRESS.</characteristic>
