            <characteristic name="Speed" typeId="5c3c-1745-c6f4-e1ab">6</characteristic>
            <characteristic name="Might" typeId="6c6c-02be-13ea-abc0">2</characteristic>
            <characteristic name="Finesse" typeId="ac91-114f-a56f-ac40">2</characteristic>
