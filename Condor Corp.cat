          </characteristics>
        </profile>
        <profile id="4efb-3031-756e-09aa" name="Curse of Adam" typeId="ee95-f962-2c95-52d1" typeName="Ability" hidden="false" page="42" publicationId="a21c-395e-03ec-6dcd">
