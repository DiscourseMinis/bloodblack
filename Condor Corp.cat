              <profiles>
                <profile id="e2eb-210d-6216-880c" name="Kimi Vivisector" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="52" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+3</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">MORTAL + MORTAL</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee. Scientist only.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Radical Surgery: If the target of this attack has any STRESS reduce their REFLEX/ DEFENSE by 1 when defending against this weapon.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="55a9-ec92-0fc4-12da" name="Muzen-Cab Syringe Gun" type="upgrade" hidden="false" page="52" publicationId="a21c-395e-03ec-6dcd">
