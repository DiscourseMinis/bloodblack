                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">STUN</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Melee.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Zookeeping: COGs damaged by this weapon that have STRESS equal to their POWER treat this weapons Potency as [TRANSCENDENT] [TRANSCENDENT].</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="971e-d220-1508-168f" name="Kimi Vivisector" type="upgrade" hidden="false" page="52" publicationId="a21c-395e-03ec-6dcd">
              <costs>
