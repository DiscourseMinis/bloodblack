                  <constraints>
                    <constraint id="8313-54f5-11a8-4779" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
                  </constraints>
                  <profiles>
                    <profile id="0a8c-7ed7-983e-ac18" name="Compensator" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                      <characteristics>
                        <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Attachment: Firearm</characteristic>
                        <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When attacking with this weapon, count pairs of dice showing the same number in the attack roll. If the attack scores at least one unblocked strike, add an additional [MORTAL] to the total damage for each matching pair of dice (before applying RESILIENCE).</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry id="2936-80e1-e6c5-f983" name="Scope" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <costs>
                    <cost name="Influence" typeId="f178-88bc-7258-0c88" value="6" />
                  </costs>
                  <constraints>
                    <constraint id="3fbb-dc4b-e8c4-9aa6" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
                  </constraints>
                  <profiles>
                    <profile id="a2b3-b8ba-17d3-db71" name="Scope" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                      <characteristics>
                        <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Attachment: Firearm</characteristic>
                        <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When this weapon’s Ranged Attack benefits from Focus, after rolling the initial attack dice, you may change one ordinary success into a Critical Success. Roll its additional die and resolve any further Critical Successes normally.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
              <profiles>
                <profile id="01fb-6b0f-7b2a-1194" name="Flamethrower" typeId="d1f1-5d47-a755-8b5f" typeName="Weapon" hidden="false" page="46" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+4</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">FIRE + FIRE</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Advanced. Firearm. Ranged.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Blast 3”: Area attack centered on the Target: radius of 3”.
Explosive Death: When this character dies, roll a D10. On a 1, deal + [FIRE] [FIRE] [FIRE] to all Characters within 4”.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
