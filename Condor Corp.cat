                <constraint id="c8cd-1712-0364-3f6a" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="2c9e-bfaf-7d19-5394" name="Cizin Archive" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="52" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When this character would deal [STUN] to a COG, you may change the Potency to [TRANSCENDENT] instead.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="32fb-5542-5ac3-c036" name="Contingency Plan" type="upgrade" hidden="false" page="52" publicationId="a21c-395e-03ec-6dcd">
