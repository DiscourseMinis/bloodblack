              <constraints>
                <constraint id="fe86-0404-9e51-0b23" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="31d5-6410-5540-b6e0" name="Radio" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Characters equipped with a radio always count as in range and line of sight of other friendly characters equipped with a radio for the purposes of Tactics.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="2ff2-af93-3674-dacb" name="Predictive Modelling" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="6" />
              </costs>
              <constraints>
                <constraint id="2519-09d8-0990-cd16" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="71e8-8516-1c44-3494" name="Predictive Modelling" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, when this character performs a FOCUS ACTION, it may give the resulting dice bonus to another friendly Character within 8″ and line of sight instead. The recipient applies this bonus to its next Test, even outside its activation. If unused, it expires at the end of the recipient's next activation. A Character can benefit from only one FOCUS bonus at a time.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="53a6-9ae8-db08-6fb0" name="Martial Arts Training" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="8" />
              </costs>
              <constraints>
                <constraint id="a223-4927-a50b-20db" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="8f26-c574-6f3d-3c65" name="Martial Arts Training" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Advanced.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">For every two successful strikes in a MELEE ATTACK roll, this character gains an additional strike.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="5ed1-54e0-2b56-7feb" name="Grapple Hook" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="8" />
              </costs>
              <constraints>
                <constraint id="022a-056c-1af2-5513" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="3fd2-3e1b-5da5-425b" name="Grapple Hook" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This character can perform a Scale Surface action within 4” of a vertical surface as a FREE ACTION. If this character falls while within 4″ of a vertical surface: it ignores any falling damage and is not automatically destroyed by falling double its speed.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="afaf-c9a2-845c-4cde" name="Autopsy Tools" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="8" />
              </costs>
              <constraints>
                <constraint id="0fd5-9aa8-4b42-a4ee" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="e638-f739-115d-6912" name="Autopsy Tools" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When a COG is killed within 8″ and line of sight of this character, choose one of that COG’s traits to record. Each trait can only be recorded once. For the remainder of the game, this character gains +1 die on ATTACK and REFLEX rolls against COGs for each recorded trait the opposing COG possesses.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="d0b5-7a1a-5ab7-7c70" name="Spectral Camera" type="upgrade" hidden="false" page="48" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
              </costs>
              <constraints>
                <constraint id="2580-1f93-d615-c9fb" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="8e5b-2b6c-4c29-8c29" name="Spectral Camera" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="48" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">While occupying a Place of Power, this character may perform an INTERACT ACTION to photograph it. This grants the Character +1 POWER for the remainder of the game (to a maximum of +3). Each Place of Power can only be photographed once by this character. After photographing three different Places of Power, it also gains +1 die on REFLEX TESTS.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="6bb6-97a1-9892-273a" name="EMF Meter" type="upgrade" hidden="false" page="48" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="12" />
              </costs>
              <constraints>
                <constraint id="2d26-fdce-27ab-62c9" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="cd90-8b36-84ea-ec89" name="EMF Meter" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="48" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per activation, while occupying an INERT Place of Power, this character may perform an INTERACT ACTION to look at the top card of the Dread Deck. Return it to the top or place it on the bottom.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
