                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">STUN</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Ranged: 8”. Scientist only.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Experimental Pharmaceuticals: DELIVER TREATMENT ACTION can Target friendly Characters up to 8” range away, gain +1 die and can be made on Characters without the MORTAL trait.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup id="f5ab-0df7-5344-f56b" name="Assets" hidden="false">
          <selectionEntries>
            <selectionEntry id="59cc-f023-c740-96a4" name="Dutch Courage" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="4" />
              </costs>
              <constraints>
                <constraint id="5967-138b-cd1a-a04c" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="6da4-5cf8-2efd-f72a" name="Dutch Courage" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">If this Character fails an Activation Test, they may choose to successfully activate instead but gain 1 STRESS and cannot lose STRESS this turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="a229-77ec-fa38-0847" name="Radio" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="5" />
              </costs>
              <constraints>
                <constraint id="8b7d-b06d-f6e6-f581" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="b843-0cbd-e4bd-6351" name="Radio" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Characters equipped with a radio always count as in range and line of sight of other friendly characters equipped with a radio for the purposes of Tactics.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="71b6-5fa7-dfeb-9e55" name="Predictive Modelling" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="6" />
              </costs>
              <constraints>
                <constraint id="e4a5-9687-6354-d083" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="d8ce-ff88-546f-8500" name="Predictive Modelling" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, when this character performs a FOCUS ACTION, it may give the resulting dice bonus to another friendly Character within 8″ and line of sight instead. The recipient applies this bonus to its next Test, even outside its activation. If unused, it expires at the end of the recipient's next activation. A Character can benefit from only one FOCUS bonus at a time.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="b960-5063-257d-09e4" name="Martial Arts Training" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="8" />
              </costs>
              <constraints>
                <constraint id="df37-fbc9-6f64-6399" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="124b-19d7-af1a-8a04" name="Martial Arts Training" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Advanced.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">For every two successful strikes in a MELEE ATTACK roll, this character gains an additional strike.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="5261-cc50-1621-b268" name="Grapple Hook" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="8" />
              </costs>
              <constraints>
                <constraint id="3d5a-73f3-4d91-4d43" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="5602-68ed-07d1-4221" name="Grapple Hook" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This character can perform a Scale Surface action within 4” of a vertical surface as a FREE ACTION. If this character falls while within 4″ of a vertical surface: it ignores any falling damage and is not automatically destroyed by falling double its speed.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="f2a7-9473-7498-387c" name="Autopsy Tools" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="8" />
              </costs>
              <constraints>
                <constraint id="de61-9dd3-aecd-b6a6" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="4ac1-1a52-44ec-985b" name="Autopsy Tools" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When a COG is killed within 8″ and line of sight of this character, choose one of that COG’s traits to record. Each trait can only be recorded once. For the remainder of the game, this character gains +1 die on ATTACK and REFLEX rolls against COGs for each recorded trait the opposing COG possesses.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="c57a-93c7-8abd-c1ed" name="Spectral Camera" type="upgrade" hidden="false" page="48" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
              </costs>
              <constraints>
                <constraint id="ac3d-aa10-f4ee-e765" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="aa73-5a98-1611-9c75" name="Spectral Camera" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="48" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">While occupying a Place of Power, this character may perform an INTERACT ACTION to photograph it. This grants the Character +1 POWER for the remainder of the game (to a maximum of +3). Each Place of Power can only be photographed once by this character. After photographing three different Places of Power, it also gains +1 die on REFLEX TESTS.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="7d37-a3f3-2216-76d8" name="EMF Meter" type="upgrade" hidden="false" page="48" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="12" />
              </costs>
              <constraints>
                <constraint id="7fa6-7f11-b583-ac65" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="9278-7627-e61a-3d58" name="EMF Meter" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="48" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per activation, while occupying an INERT Place of Power, this character may perform an INTERACT ACTION to look at the top card of the Dread Deck. Return it to the top or place it on the bottom.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="2d51-da99-9e2d-15e4" name="Cizin Archive" type="upgrade" hidden="false" page="52" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="5" />
              </costs>
              <constraints>
                <constraint id="1db2-41d8-c9df-1b8b" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="e5ec-3928-6276-43cb" name="Cizin Archive" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="52" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When this character would deal [STUN] to a COG, you may change the Potency to [TRANSCENDENT] instead.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="1ff6-4d15-d6f2-8caa" name="Contingency Plan" type="upgrade" hidden="false" page="52" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="8" />
              </costs>
              <constraints>
                <constraint id="1569-2413-acee-fd00" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="ed8c-065d-f938-ea42" name="Contingency Plan" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="52" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, before making a MELEE ATTACK, this Character may gain 1 STRESS to use its POWER instead of MIGHT for that attack.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="1b7b-b381-f35e-533d" name="Experimental Stimulants" type="upgrade" hidden="false" page="52" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="8" />
              </costs>
              <constraints>
                <constraint id="168a-2709-7815-a189" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="7458-5b22-7909-a2f7" name="Experimental Stimulants" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="52" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, before this Character or a friendly MORTAL character within 3″ makes an Activation Test, this character may administer stimulants. The target removes up to 2 STRESS and loses 1 VITALITY.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="3831-e187-2b21-701f" name="Epsilon Clearance" type="upgrade" hidden="false" page="52" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="15" />
              </costs>
              <constraints>
                <constraint id="a162-b3fb-c93e-9b2e" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="0a35-b348-c3a8-dfb5" name="Epsilon Clearance" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="52" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
