                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Characters equipped with a radio always count as in range and line of sight of other friendly characters equipped with a radio for the purposes of Tactics.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="31e8-cea4-ec82-9439" name="Predictive Modelling" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="6" />
              </costs>
              <constraints>
                <constraint id="f09a-f371-76ac-4f23" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="fe36-c6fe-df7e-05d1" name="Predictive Modelling" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, when this character performs a FOCUS ACTION, it may give the resulting dice bonus to another friendly Character within 8″ and line of sight instead. The recipient applies this bonus to its next Test, even outside its activation. If unused, it expires at the end of the recipient's next activation. A Character can benefit from only one FOCUS bonus at a time.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="6954-286f-23bf-6b9f" name="Martial Arts Training" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="8" />
              </costs>
              <constraints>
                <constraint id="0358-13f7-df96-11ca" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="505a-8c8a-9f67-d748" name="Martial Arts Training" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Advanced.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">For every two successful strikes in a MELEE ATTACK roll, this character gains an additional strike.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="795d-fc2c-a9b5-800e" name="Grapple Hook" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="8" />
              </costs>
              <constraints>
                <constraint id="7031-579d-b485-e6e6" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="170a-e113-ff05-4720" name="Grapple Hook" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This character can perform a Scale Surface action within 4” of a vertical surface as a FREE ACTION. If this character falls while within 4″ of a vertical surface: it ignores any falling damage and is not automatically destroyed by falling double its speed.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="e3d4-7d64-aa61-c9d9" name="Autopsy Tools" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="8" />
              </costs>
              <constraints>
                <constraint id="095b-4a1f-d099-1275" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="6ada-63fa-d9bb-d06c" name="Autopsy Tools" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When a COG is killed within 8″ and line of sight of this character, choose one of that COG’s traits to record. Each trait can only be recorded once. For the remainder of the game, this character gains +1 die on ATTACK and REFLEX rolls against COGs for each recorded trait the opposing COG possesses.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="9872-3de9-0c09-b561" name="Spectral Camera" type="upgrade" hidden="false" page="48" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
              </costs>
              <constraints>
                <constraint id="9ac6-575c-7077-55af" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="0dd7-d7f7-e107-7d68" name="Spectral Camera" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="48" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">While occupying a Place of Power, this character may perform an INTERACT ACTION to photograph it. This grants the Character +1 POWER for the remainder of the game (to a maximum of +3). Each Place of Power can only be photographed once by this character. After photographing three different Places of Power, it also gains +1 die on REFLEX TESTS.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="3546-5c52-8135-acd7" name="EMF Meter" type="upgrade" hidden="false" page="48" publicationId="a21c-395e-03ec-6dcd">
