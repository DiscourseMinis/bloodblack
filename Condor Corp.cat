                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When this character would deal [STUN] to a COG, you may change the Potency to [TRANSCENDENT] instead.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
