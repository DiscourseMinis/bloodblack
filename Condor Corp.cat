                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, before making a MELEE ATTACK, this Character may gain 1 STRESS to use its POWER instead of MIGHT for that attack.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
