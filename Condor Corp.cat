                  <characteristics>
                    <characteristic name="Velocity" typeId="f173-8d0e-3d35-61a4">+0</characteristic>
                    <characteristic name="Potency" typeId="eca4-f354-09c4-9fb7">STUN</characteristic>
                    <characteristic name="Traits and range" typeId="5aca-a7b8-a2de-08fa">Ranged: 8”. Scientist only.</characteristic>
                    <characteristic name="Special rules" typeId="8c35-8c96-b5da-3d94">Experimental Pharmaceuticals: DELIVER TREATMENT ACTION can Target friendly Characters up to 8” range away, gain +1 die and can be made on Characters without the MORTAL trait.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup id="7551-5776-2498-80fd" name="Assets" hidden="false">
          <selectionEntries>
            <selectionEntry id="dc9c-b8b4-79ed-be95" name="Dutch Courage" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
