                <selectionEntry id="2566-93f7-8467-3ea2" name="Compensator" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <costs>
                    <cost name="Influence" typeId="f178-88bc-7258-0c88" value="5" />
                  </costs>
                  <constraints>
                    <constraint id="232c-e947-99c6-84f2" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
                  </constraints>
                  <profiles>
                    <profile id="cdb4-b1f6-f586-8720" name="Compensator" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                      <characteristics>
                        <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Attachment: Firearm</characteristic>
                        <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When attacking with this weapon, count pairs of dice showing the same number in the attack roll. If the attack scores at least one unblocked strike, add an additional [MORTAL] to the total damage for each matching pair of dice (before applying RESILIENCE).</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry id="3db5-6d0f-2e7e-85e9" name="Scope" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
