              </constraints>
              <profiles>
                <profile id="5d60-1218-a53e-1901" name="Dutch Courage" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">If this Character fails an Activation Test, they may choose to successfully activate instead but gain 1 STRESS and cannot lose STRESS this turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="569e-7df2-7a1e-4722" name="Radio" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="5" />
              </costs>
              <constraints>
                <constraint id="b717-770b-55ac-972d" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="44f0-770a-f531-ec6d" name="Radio" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Characters equipped with a radio always count as in range and line of sight of other friendly characters equipped with a radio for the purposes of Tactics.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="be84-a40d-b541-0a25" name="Predictive Modelling" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="6" />
              </costs>
              <constraints>
                <constraint id="c19c-411e-ef0d-1ac9" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="c2e8-aa2a-d6b6-a6e4" name="Predictive Modelling" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, when this character performs a FOCUS ACTION, it may give the resulting dice bonus to another friendly Character within 8″ and line of sight instead. The recipient applies this bonus to its next Test, even outside its activation. If unused, it expires at the end of the recipient's next activation. A Character can benefit from only one FOCUS bonus at a time.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="7cc8-c7e3-921d-8a99" name="Martial Arts Training" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="8" />
              </costs>
              <constraints>
                <constraint id="3137-fd2a-1b80-9263" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="1cda-53ac-6560-4a19" name="Martial Arts Training" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Advanced.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">For every two successful strikes in a MELEE ATTACK roll, this character gains an additional strike.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="0cf2-089c-62c3-8208" name="Grapple Hook" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="8" />
              </costs>
              <constraints>
                <constraint id="f3d7-0067-8337-68d3" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="61c7-9e04-45b3-c3e1" name="Grapple Hook" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This character can perform a Scale Surface action within 4” of a vertical surface as a FREE ACTION. If this character falls while within 4″ of a vertical surface: it ignores any falling damage and is not automatically destroyed by falling double its speed.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="07c0-580a-aeb7-d6c3" name="Autopsy Tools" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="8" />
              </costs>
              <constraints>
                <constraint id="50c9-686e-e2ac-7bad" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="fcaf-e8d5-2fb2-7a24" name="Autopsy Tools" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When a COG is killed within 8″ and line of sight of this character, choose one of that COG’s traits to record. Each trait can only be recorded once. For the remainder of the game, this character gains +1 die on ATTACK and REFLEX rolls against COGs for each recorded trait the opposing COG possesses.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="d3f0-6842-af9c-7a05" name="Spectral Camera" type="upgrade" hidden="false" page="48" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
              </costs>
              <constraints>
                <constraint id="a486-0cae-2e59-b14f" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="f42a-cd53-a5f5-b4e3" name="Spectral Camera" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="48" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">While occupying a Place of Power, this character may perform an INTERACT ACTION to photograph it. This grants the Character +1 POWER for the remainder of the game (to a maximum of +3). Each Place of Power can only be photographed once by this character. After photographing three different Places of Power, it also gains +1 die on REFLEX TESTS.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="ea6c-b8d0-88ed-fddc" name="EMF Meter" type="upgrade" hidden="false" page="48" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="12" />
              </costs>
              <constraints>
                <constraint id="6e5a-0dfc-cf28-3b37" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="bdc7-8788-baee-c94c" name="EMF Meter" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="48" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per activation, while occupying an INERT Place of Power, this character may perform an INTERACT ACTION to look at the top card of the Dread Deck. Return it to the top or place it on the bottom.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="e761-1bc6-c006-62b8" name="Cizin Archive" type="upgrade" hidden="false" page="52" publicationId="a21c-395e-03ec-6dcd">
