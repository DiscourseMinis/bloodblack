        <selectionEntryGroup id="ef54-3c6b-c494-6d56" name="Chimera Augmentations" hidden="false">
          <selectionEntryGroups>
            <selectionEntryGroup id="5f85-de55-9a84-1920" name="Brain" hidden="false">
              <constraints>
                <constraint id="2a97-167c-5cfd-b504" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <selectionEntries>
                <selectionEntry id="486e-64b9-5449-9ac8" name="Gein Programming Surgery" type="upgrade" hidden="false" page="53" publicationId="a21c-395e-03ec-6dcd">
                  <costs>
                    <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
                  </costs>
                  <constraints>
                    <constraint id="65d2-eb7e-eb2c-74d5" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
                  </constraints>
                  <profiles>
                    <profile id="e4ff-03be-12fd-20b9" name="Gein Programming Surgery" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="53" publicationId="a21c-395e-03ec-6dcd">
                      <characteristics>
                        <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Brain slot</characteristic>
                        <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, if this Character begins an activation in base contact with another character (whether friendly or enemy), it must immediately make a free MELEE ATTACK against a Character in base contact, before making its Activation Test.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry id="fe48-028c-c235-8f3b" name="Doppelganger Hemisphere" type="upgrade" hidden="false" page="53" publicationId="a21c-395e-03ec-6dcd">
                  <costs>
                    <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
                  </costs>
                  <constraints>
                    <constraint id="ceb1-917e-1470-e016" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
                  </constraints>
                  <profiles>
                    <profile id="1e81-3cb2-7a6c-36b3" name="Doppelganger Hemisphere" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="53" publicationId="a21c-395e-03ec-6dcd">
                      <characteristics>
                        <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Brain slot</characteristic>
                        <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This character's REFLEX is reduced to 0. When defending against an attack, its REFLEX is instead equal to the number of successful dice in the attacker's attack roll.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry id="a42f-5c5e-9af2-648c" name="Second Brain Xenograft" type="upgrade" hidden="false" page="53" publicationId="a21c-395e-03ec-6dcd">
                  <costs>
                    <cost name="Influence" typeId="f178-88bc-7258-0c88" value="10" />
                  </costs>
