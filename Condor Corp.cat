              </costs>
              <constraints>
                <constraint id="6eed-2e04-ab40-7b85" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="5c65-3327-fb6b-32b1" name="Contingency Plan" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="52" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, before making a MELEE ATTACK, this Character may gain 1 STRESS to use its POWER instead of MIGHT for that attack.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
