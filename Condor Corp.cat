              </costs>
              <constraints>
                <constraint id="b35b-1229-e1c9-db53" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
              </constraints>
              <profiles>
                <profile id="a919-4d05-0f7f-f60c" name="Experimental Stimulants" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="52" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Restriction: Scientist only.</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">Once per turn, before this Character or a friendly MORTAL character within 3″ makes an Activation Test, this character may administer stimulants. The target removes up to 2 STRESS and loses 1 VITALITY.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
