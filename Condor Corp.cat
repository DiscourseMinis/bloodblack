              <profiles>
                <profile id="a88f-4d02-fec3-e97f" name="Dutch Courage" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                  <characteristics>
                    <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">—</characteristic>
                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">If this Character fails an Activation Test, they may choose to successfully activate instead but gain 1 STRESS and cannot lose STRESS this turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry id="9b3d-03b1-0fc8-c515" name="Radio" type="upgrade" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
              <costs>
                <cost name="Influence" typeId="f178-88bc-7258-0c88" value="5" />
