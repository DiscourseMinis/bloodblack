                    <profile id="d06b-20b2-a347-bb51" name="Primordial Ooze Saturation" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="53" publicationId="a21c-395e-03ec-6dcd">
                      <characteristics>
                        <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Bones slot</characteristic>
                        <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This character ignores STRESS penalties when making MIGHT tests. When making MELEE ATTACKS, it gains +1 MIGHT for each STRESS it has, up to a maximum bonus equal to its POWER.</characteristic>
