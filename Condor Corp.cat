                  </costs>
                  <constraints>
                    <constraint id="cec2-2a39-5b32-abee" type="max" value="1" field="selections" scope="parent" shared="false" includeChildSelections="false" includeChildForces="false" percentValue="false" />
                  </constraints>
                  <profiles>
                    <profile id="ee46-4ad8-8632-cf70" name="Scope" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                      <characteristics>
                        <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Attachment: Firearm</characteristic>
                        <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">When this weapon’s Ranged Attack benefits from Focus, after rolling the initial attack dice, you may change one ordinary success into a Critical Success. Roll its additional die and resolve any further Critical Successes normally.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
