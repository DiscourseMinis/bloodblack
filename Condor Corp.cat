                    <characteristic name="Effect" typeId="a0d4-cc2f-58cd-e83f">This character gains +2 POWER.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
