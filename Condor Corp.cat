                  </constraints>
                  <profiles>
                    <profile id="9a2b-ed8a-c357-3d83" name="Laser Sight" typeId="838e-a506-1f18-c702" typeName="Asset" hidden="false" page="47" publicationId="a21c-395e-03ec-6dcd">
                      <characteristics>
                        <characteristic name="Restrictions / type" typeId="ea80-62e5-9e79-5ed4">Attachment: Firearm</characteristic>
